NEXT_PUBLIC_API_URL=http://localhost:4000

# Google Analytics 4 measurement id (Admin > Data Streams > your web stream).
# When set, <GoogleAnalytics> loads gtag.js and the storefront emits GA4
# e-commerce events (view_item / add_to_cart / purchase / …). Leave empty to
# disable analytics entirely — nothing loads and every tracker call no-ops.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ImageKit (free tier) URL endpoint for the account that hosts product/
# collection/category images. src/lib/imagekit-loader.ts doesn't read this
# var itself (it transforms whatever full URL is already stored on the
# image), it's documented here for reference.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=

# Public key from the same ImageKit account (Developer options > API Keys) —
# safe to expose client-side. Used by the admin image uploader
# (lib/imagekit-upload.ts) alongside a short-lived signed token from the
# backend (see backend/.env.example's IMAGEKIT_PRIVATE_KEY).
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=

# hCaptcha site key for the checkout email-OTP widget. Defaulted to
# hCaptcha's own documented test sitekey (pairs with the backend's default
# HCAPTCHA_SECRET test value) — fine for dev, swap both for a real
# registered site's keys before production.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001

# Web Push public key for the admin Notifications panel — must be the public
# half of the backend's VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY pair (see
# backend/.env.example). Empty ⇒ the panel shows as unsupported/disabled
# rather than erroring.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
