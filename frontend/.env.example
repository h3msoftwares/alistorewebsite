NEXT_PUBLIC_API_URL=http://localhost:4000

# ImageKit (free tier) URL endpoint for the account that will host product
# images, e.g. https://ik.imagekit.io/<your_imagekit_id> — set once a real
# account exists. src/lib/imagekit-loader.ts doesn't read this var itself
# (it transforms whatever full URL is already in ProductImage.url), it's
# documented here for whoever wires the real Week 2 upload endpoint.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
