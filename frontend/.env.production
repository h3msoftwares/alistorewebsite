# Loaded by `next build` (including the Cloudflare CI build). NEXT_PUBLIC_* is
# inlined at build time, so the statically-generated pages, sitemap.xml,
# robots.txt, canonical tags and Open Graph URLs all need this present during
# the build — a missing value silently falls back to http://localhost:3000
# (see lib/site.ts getSiteUrl). Public URL, not a secret.
NEXT_PUBLIC_SITE_URL=https://alistore.clothing
