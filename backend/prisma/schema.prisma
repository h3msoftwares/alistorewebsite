// Ali's Store — e-commerce schema
// Convention carried over from the original pos-backend schema:
// - uuid primary keys, PascalCase models mapped to lowercase tables (@@map)
// - camelCase columns, Decimal for money, soft-delete via deletedAt where relevant
// - dateCreated / createdAt naming kept per-model to match what pos-backend used

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum OAuthProvider {
  GOOGLE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  CARD // reserved for future online payment; application rejects it until a gateway is integrated
}

enum PaymentStatus {
  PENDING
  COLLECTED
  REFUNDED
}

enum StockMovementType {
  INITIAL
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  RESTOCK
}

// How a product's sale is expressed: a percentage off (0–100) or a flat
// amount off the price. Reused for catalog Discounts and Coupons.
enum DiscountType {
  PERCENT
  AMOUNT
}

// What a catalog Discount applies to.
enum DiscountScope {
  ALL // every product
  COLLECTION // products in one collection
  CATEGORY // products in one category
}

// How a catalog Discount interacts with a product's own sale:
//  STACK    — apply the product's sale first, then this discount off the
//             already-reduced price (compounds).
//  OVERRIDE — this discount comes off the original price; the product's own
//             sale is ignored while the discount is active.
enum DiscountStacking {
  STACK
  OVERRIDE
}

// Built-in "smart" home-page rows — computed product lists the owner can turn
// on and slot into the featured-row order without creating a real category.
enum ShowcaseType {
  BEST_SELLERS
  NEW_ARRIVALS
  ON_SALE
}

// ============ USERS / AUTH ============

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String?   @unique
  emailVerified       DateTime? // set automatically on first Google OAuth login (Google pre-verifies)
  phone               String?   @unique
  passwordHash        String? // null for OAuth-only accounts
  name                String
  role                UserRole  @default(CUSTOMER)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0) // reset to 0 on any successful login
  lockedUntil         DateTime? // set when failedLoginAttempts crosses the threshold; login refused until this passes
  dateCreated         DateTime  @default(now())
  deletedAt           DateTime?

  // RBAC. `role` is the coarse gate (CUSTOMER = storefront only; STAFF/ADMIN
  // may reach /admin). Granular admin access is by permission:
  //  - STAFF: the permission list of `customRole` (none ⇒ no admin access)
  //  - ADMIN: every permission, minus `revokedPermissions`
  // `revokedPermissions` also subtracts from a STAFF user's role grants.
  customRoleID       String?  @db.Uuid
  customRole         Role?    @relation(fields: [customRoleID], references: [id], onDelete: SetNull)
  revokedPermissions String[] @default([])

  addresses               Address[]
  cart                    Cart?
  favorites               Favorite[]
  orders                  Order[]
  refreshTokens           RefreshToken[]
  oauthAccounts           OAuthAccount[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogs               AuditLog[] // rows where this user was the actor
  stockMovements          StockMovement[] // manual stock adjustments made by this user
  blacklistEntries        BlacklistEntry[] // entries this admin created
  pushSubscriptions       PushSubscription[] // this admin's opted-in browser/device(s)

  @@index([role])
  @@index([customRoleID])
  @@map("user")
}

// A named set of admin permissions the owner defines from /admin/roles and
// assigns to STAFF users. Permission keys are "<area>:view" / "<area>:manage"
// (see backend/src/lib/permissions.ts). `isSystem` roles can't be deleted.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  dateCreated DateTime @default(now())
  lastEdit    DateTime @default(now()) @updatedAt

  users User[]

  @@map("role")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userID            String    @db.Uuid
  familyID          String    @db.Uuid // shared across a rotation chain; revoke the whole family on replay
  tokenHash         String    @unique
  replacedByTokenID String?   @unique @db.Uuid // the token issued when this one was rotated
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  // When a password was last actually verified for this login (step-up auth).
  // Set at login; carried UNCHANGED through every silent rotation so a kept
  // -alive session never looks freshly authenticated. A fresh login or an
  // explicit /api/auth/step-up starts a new family with a new authTime.
  authTime          DateTime  @default(now())

  user       User          @relation(fields: [userID], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedByTokenID], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userID])
  @@index([familyID])
  @@map("refreshtoken")
}

// Single-use, short-expiry token for the forgotten-password flow. Same shape
// as RefreshToken: only the hash is stored.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userID    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID])
  @@map("passwordresettoken")
}

// Single-use, short-expiry token for the email-verification flow (customer
// registration + resend-verification). Identical shape to PasswordResetToken:
// only the SHA-256 hash of the raw token is stored, never the token itself.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userID    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID])
  @@map("emailverificationtoken")
}

// External identity (Google today; enum leaves room for more). One row per
// provider account linked to a User.
model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userID            String        @db.Uuid
  provider          OAuthProvider
  providerAccountID String // the "sub" claim from the provider
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime      @default(now())
  lastEdit          DateTime      @default(now()) @updatedAt

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountID])
  @@index([userID])
  @@map("oauthaccount")
}

// Generic append-only audit trail. One table for every logged event (admin
// login attempts, order status changes, stock edits, ...) instead of a table
// per event type. `metadata` is a loose JSON blob for event-specific detail.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String // e.g. "order", "user", "productVariant"
  entityID   String? // id of the affected row, when there is one
  action     String // e.g. "login.failed", "order.status_changed", "stock.adjusted"
  actorID    String?  @db.Uuid // the acting user, when known (null for anonymous/system)
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorID], references: [id], onDelete: SetNull)

  @@index([entityType, entityID])
  @@index([actorID])
  @@index([createdAt])
  @@map("auditlog")
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userID      String   @db.Uuid
  fullName    String
  phone       String
  addressLine String
  city        String
  area        String?
  region      String? // Lebanese governorate — one of the DELIVERY_REGIONS values
  notes       String?
  isDefault   Boolean  @default(false)
  dateCreated DateTime @default(now())

  user   User    @relation(fields: [userID], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userID])
  @@map("address")
}

// ============ CATALOG ============

// Collections replace the old fixed Department enum. The owner can create any
// number of collections (e.g. Women, Men, Kids, Summer Sale) from the admin UI
// and attach categories to them. Hierarchy: Collection -> Category -> Product.
model Collection {
  id                String    @id @default(uuid()) @db.Uuid
  nameEn            String
  nameAr            String
  slug              String    @unique
  descriptionEn     String?
  descriptionAr     String?
  isActive          Boolean   @default(true)
  // Owner opts a collection into the top nav / footer; nav order is `sortOrder`.
  showInNav         Boolean   @default(false)
  // Owner opts a collection into the home page's featured row (own row: name +
  // horizontal scroll of its categories). Independent of showInNav — a
  // collection can be navigable without being featured, or vice versa.
  showOnHome        Boolean   @default(false)
  // Owner shows this collection on the home page as a full-width image banner
  // (coloured panel + CTA, and the photo). Takes precedence over showOnHome —
  // an image-collection is not also given a scrolling row.
  showOnHomeAsImage Boolean   @default(false)
  // Position in the top nav (with showInNav). NOT the home-page order.
  sortOrder         Int       @default(0)
  // Position on the home page — the single shared ranking key for EVERY home
  // block (featured collections, image banners, featured categories, smart
  // rows), so the owner orders them all in one list. Separate from sortOrder
  // so nav order and home order are independent.
  homeSortOrder     Int       @default(0)
  // #rrggbb — the storefront derives the --collection-accent* CSS custom
  // properties from this. null ⇒ the collection uses the default accent. Also
  // the background colour of the home-page image banner (showOnHomeAsImage).
  accentColor       String?
  // Call-to-action label on the home-page image banner (showOnHomeAsImage).
  // null / "" ⇒ a generic "Shop <name>". `descriptionEn`/`descriptionAr` fill
  // the banner's copy.
  homeImageCtaEn    String?
  homeImageCtaAr    String?
  // Set when the owner archives the collection from the admin: hidden from
  // the storefront, kept in the DB, restorable. Permanent delete is only
  // allowed once archived (and empty of products).
  archivedAt        DateTime?
  dateCreated       DateTime  @default(now())
  lastEdit          DateTime  @default(now()) @updatedAt

  images      CollectionImage[]
  categories  Category[]
  products    Product[]
  siteHeroFor SiteSetting[]
  discounts   Discount[]

  @@index([isActive])
  @@index([archivedAt])
  @@map("collection")
}

// Same shape/behaviour as ProductImage — a gallery table (url + bilingual alt
// + sortOrder), cascade-deleted with its parent. The "base" image is the row
// with the lowest sortOrder.
model CollectionImage {
  id           String  @id @default(uuid()) @db.Uuid
  collectionID String  @db.Uuid
  url          String
  // ImageKit's file id for this asset — lets us delete the underlying file
  // (not just the DB row) when the image is removed. Nullable: rows created
  // before this column existed have no known fileId, so they're left alone
  // on delete rather than guessed at.
  fileId       String?
  altEn        String?
  altAr        String?
  sortOrder    Int     @default(0)

  collection Collection @relation(fields: [collectionID], references: [id], onDelete: Cascade)

  @@index([collectionID])
  @@map("collectionimage")
}

model Category {
  id               String    @id @default(uuid()) @db.Uuid
  // Nullable: a category may stand alone, unattached to any collection. Deleting
  // a collection detaches its categories (SET NULL) rather than removing them.
  collectionID     String?   @db.Uuid
  nameEn           String
  nameAr           String
  slug             String    @unique
  parentCategoryID String?   @db.Uuid
  isActive         Boolean   @default(true)
  // Owner opts a category into the home page's featured row (own row: name +
  // horizontal scroll of its products) — independent of its parent
  // collection's own showOnHome.
  showOnHome       Boolean   @default(false)
  // Position among this category's siblings on their collection's page and in
  // that collection's home row. NOT the home-page order.
  sortOrder        Int       @default(0)
  // Position of this category's OWN featured row on the home page — the same
  // shared key as Collection.homeSortOrder, so every home block orders in one
  // list. Separate from sortOrder (sibling order within a collection).
  homeSortOrder    Int       @default(0)
  // See Collection.archivedAt — archive is the admin's primary "remove"
  // action; permanent delete needs the category archived and empty first.
  archivedAt       DateTime?

  collection Collection?     @relation(fields: [collectionID], references: [id], onDelete: SetNull)
  parent     Category?       @relation("CategoryToSubcategory", fields: [parentCategoryID], references: [id], onDelete: SetNull)
  children   Category[]      @relation("CategoryToSubcategory")
  images     CategoryImage[]
  products   Product[]
  discounts  Discount[]

  @@index([collectionID])
  @@index([parentCategoryID])
  @@index([archivedAt])
  @@map("category")
}

// Same shape/behaviour as ProductImage. The "base" image is the row with the
// lowest sortOrder.
model CategoryImage {
  id         String  @id @default(uuid()) @db.Uuid
  categoryID String  @db.Uuid
  url        String
  // See CollectionImage.fileId.
  fileId     String?
  altEn      String?
  altAr      String?
  sortOrder  Int     @default(0)

  category Category @relation(fields: [categoryID], references: [id], onDelete: Cascade)

  @@index([categoryID])
  @@map("categoryimage")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  sku            String        @unique
  nameEn         String
  nameAr         String
  descriptionEn  String?
  descriptionAr  String?
  categoryID     String        @db.Uuid
  collectionID   String?       @db.Uuid // denormalized mirror of Category.collectionID (null when the category stands alone); derived from the category in app code, never set directly
  price          Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?      @db.Decimal(12, 2)
  // Active sale: PERCENT (0–100) or AMOUNT off `price`. Both null ⇒ no sale.
  saleType       DiscountType?
  saleValue      Decimal?      @db.Decimal(12, 2)
  // Product-level quantity. Free-standing signed integer — may be 0 or
  // negative (e.g. oversold), and has no bearing on `isActive`.
  quantity       Int           @default(0)
  isActive       Boolean       @default(true)
  dateCreated    DateTime      @default(now())
  lastEdit       DateTime      @default(now()) @updatedAt
  deletedAt      DateTime?
  // Generated, READ-ONLY search haystack — Postgres computes it (see migration
  // 20260909180000_product_search_text): lower(nameEn + nameAr) plus a
  // punctuation/whitespace-stripped copy so "tshirt" matches "T-Shirt". It is
  // NOT NULL in the DB; typed optional here only so Prisma leaves it out of
  // every INSERT/UPDATE (a generated column rejects an explicit value). Never
  // write it from app code.
  searchText     String?

  category   Category         @relation(fields: [categoryID], references: [id])
  collection Collection?      @relation(fields: [collectionID], references: [id], onDelete: SetNull)
  images     ProductImage[]
  variants   ProductVariant[]
  favorites  Favorite[]

  @@index([categoryID])
  @@index([collectionID])
  @@map("product")
}

// A catalog-wide discount the admin runs over ALL products, one collection,
// or one category. Resolved live at read time (product listings, cart,
// checkout) — nothing is written onto Product. When more than one active
// discount could apply to a product, the most specific scope wins
// (CATEGORY > COLLECTION > ALL); within the winning scope the one giving the
// larger reduction is used. `startsAt` / `endsAt` null ⇒ open-ended on that
// side. See lib/pricing.ts for how `stacking` combines with a product's own
// sale.
model Discount {
  id           String           @id @default(uuid()) @db.Uuid
  nameEn       String
  nameAr       String
  scope        DiscountScope
  collectionID String?          @db.Uuid // set iff scope = COLLECTION
  categoryID   String?          @db.Uuid // set iff scope = CATEGORY
  type         DiscountType
  value        Decimal          @db.Decimal(12, 2) // PERCENT: 0–100; AMOUNT: currency off
  stacking     DiscountStacking @default(STACK)
  isActive     Boolean          @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  dateCreated  DateTime         @default(now())
  lastEdit     DateTime         @default(now()) @updatedAt

  collection Collection? @relation(fields: [collectionID], references: [id], onDelete: Cascade)
  category   Category?   @relation(fields: [categoryID], references: [id], onDelete: Cascade)

  @@index([scope])
  @@index([collectionID])
  @@index([categoryID])
  @@index([isActive])
  @@map("discount")
}

// A code the shopper enters at checkout for a discount off the (already
// per-product-sale + catalog-discount reduced) cart subtotal. Time-boxed by
// `startsAt` / `endsAt` (null ⇒ open-ended). No usage caps or per-customer
// limits — the code just works while active and in-window.
model Coupon {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique // stored upper-cased; compared case-insensitively
  type        DiscountType
  value       Decimal      @db.Decimal(12, 2) // PERCENT: 0–100; AMOUNT: currency off
  isActive    Boolean      @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  // Usage caps (enforced at checkout — see order.service.ts).
  //  `maxRedemptions` — total across all shoppers; null = unlimited.
  //  `maxPerCustomer` — per account / per guest-email; DEFAULTS TO 1 so a
  //    coupon is single-use per customer unless the admin opts into more (or
  //    null for unlimited). `timesRedeemed` is the atomic global counter.
  maxRedemptions Int?
  maxPerCustomer Int?         @default(1)
  timesRedeemed  Int          @default(0)
  dateCreated DateTime     @default(now())
  lastEdit    DateTime     @default(now()) @updatedAt

  redemptions CouponRedemption[]

  @@map("coupon")
}

// One row per time a coupon is applied to an order. The audit trail behind
// the usage caps: `maxPerCustomer` is enforced by counting these.
model CouponRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  couponID  String   @db.Uuid
  orderID   String   @unique @db.Uuid // one redemption per order
  userID    String?  @db.Uuid // null for a guest checkout
  email     String? // contact email — how a guest's per-customer count is keyed
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponID], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderID], references: [id], onDelete: Cascade)

  @@index([couponID, userID])
  @@index([couponID, email])
  @@map("couponredemption")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productID String  @db.Uuid
  url       String
  // See CollectionImage.fileId.
  fileId    String?
  altEn     String?
  altAr     String?
  sortOrder Int     @default(0)
  // Ties this image to one colour option (matches ProductVariant.color) — the
  // product page swaps to the matching image(s) when that colour is selected.
  // null = shown regardless of colour (generic/fallback shots).
  color     String?

  product Product @relation(fields: [productID], references: [id], onDelete: Cascade)

  @@index([productID])
  @@map("productimage")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productID     String   @db.Uuid
  sku           String   @unique
  size          String? // nullable: not every product has a size (one-size accessories, etc.)
  color         String? // nullable: not every product has a colour variation
  // Per-variant price override — null falls back to Product.price, so
  // different sizes/colours of the same product can share one price or each
  // carry their own.
  price         Decimal? @db.Decimal(12, 2)
  // DB CHECK ("stockQuantity" >= 0) — see migration
  // 20260908234500_stock_nonnegative_check. Prisma can't express CHECKs in
  // the schema; the authoritative oversell guard is the atomic conditional
  // decrement in order.service.ts, this is the backstop.
  stockQuantity Int      @default(0)

  product        Product         @relation(fields: [productID], references: [id], onDelete: Cascade)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  // NOTE: no more @@unique([productID, size, color]) — Postgres treats each NULL
  // as distinct, so it would no longer catch duplicate (null,null) variants.
  // Duplicate-variant prevention is now enforced in application code.
  @@index([productID])
  @@map("productvariant")
}

// Append-only stock ledger: every change to ProductVariant.stockQuantity gets
// a row here recording the signed delta and why. `stockQuantity` stays as the
// materialized current value.
model StockMovement {
  id        String            @id @default(uuid()) @db.Uuid
  variantID String            @db.Uuid
  quantity  Int // signed delta: negative for a sale, positive for a restock
  type      StockMovementType
  reason    String?
  orderID   String?           @db.Uuid // set when the movement was caused by an order
  actorID   String?           @db.Uuid // the staff/admin user for a manual adjustment
  createdAt DateTime          @default(now())

  variant ProductVariant @relation(fields: [variantID], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderID], references: [id], onDelete: SetNull)
  actor   User?          @relation(fields: [actorID], references: [id], onDelete: SetNull)

  @@index([variantID])
  @@index([orderID])
  @@map("stockmovement")
}

// ============ CART ============

// One Cart per user (userID unique) or per guest session (sessionID unique).
// Guest->user merge on login re-points / merges a single Cart row instead of
// rewriting every CartItem.
model Cart {
  id          String   @id @default(uuid()) @db.Uuid
  userID      String?  @unique @db.Uuid
  sessionID   String?  @unique
  currency    String   @default("USD")
  dateCreated DateTime @default(now())
  lastEdit    DateTime @default(now()) @updatedAt

  user  User?      @relation(fields: [userID], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("cart")
}

model CartItem {
  id          String   @id @default(uuid()) @db.Uuid
  cartID      String   @db.Uuid
  variantID   String   @db.Uuid
  quantity    Int      @default(1)
  dateCreated DateTime @default(now())

  cart    Cart           @relation(fields: [cartID], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantID], references: [id], onDelete: Cascade)

  @@unique([cartID, variantID])
  @@index([cartID])
  @@map("cartitem")
}

// ============ FAVORITES ============

// A shopper's wishlist. One row per (user, product) — hearting is idempotent,
// enforced by the composite unique. Guests keep their hearts client-side
// (favouritesSlice + localStorage); this table is the logged-in mirror, so
// every /api/favourites route sits behind requireAuth like /api/addresses.
model Favorite {
  id          String   @id @default(uuid()) @db.Uuid
  userID      String   @db.Uuid
  productID   String   @db.Uuid
  dateCreated DateTime @default(now())

  user    User    @relation(fields: [userID], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productID], references: [id], onDelete: Cascade)

  @@unique([userID, productID])
  @@index([userID])
  @@map("favorite")
}

// ============ ORDERS ============

model Order {
  id          String  @id @default(uuid()) @db.Uuid
  orderNumber String  @unique
  userID      String? @db.Uuid
  addressID   String? @db.Uuid // reference to a saved Address, when the customer used one
  guestEmail  String? // contact email for a guest order (no saved account)

  // Anti-abuse — see BlacklistEntry / CheckoutOtp. Captured from req.ip at
  // checkout time; used for both the hard blacklist check and the soft
  // order-velocity flag below.
  ipAddress        String?
  // Soft flag: an automatic order-velocity threshold was crossed (see
  // order.service.ts checkout()). The order is still created normally —
  // this only surfaces it for admin review, unlike a BlacklistEntry hit
  // which hard-blocks instead.
  flaggedForReview Boolean @default(false)
  // Short machine string, e.g. "velocity:phone,velocity:ip" — which
  // threshold(s) tripped, for admin context. Null when not flagged.
  flaggedReason    String?

  // Delivery snapshot — captured at order time so a later edit/delete of the
  // saved Address never changes what this order shows was delivered where.
  deliveryName    String
  deliveryPhone   String
  deliveryAddress String
  deliveryCity    String
  deliveryArea    String?
  deliveryRegion  String? // Lebanese governorate — set on every new checkout; null only on legacy rows
  deliveryNotes   String?

  notes         String? // general order notes from the customer
  // Set by the admin when the order is shipped (or any later status change) —
  // the "arrives in about N days" estimate; also used in the shipped email.
  estimatedDeliveryDays Int?
  subtotal      Decimal       @db.Decimal(12, 2) // merchandise after per-product sales + catalog discounts, before any coupon
  couponCode    String? // the coupon applied at checkout, upper-cased; null if none
  discountAmount Decimal      @default(0) @db.Decimal(12, 2) // amount the coupon took off the subtotal
  deliveryFee   Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2) // subtotal - discountAmount + deliveryFee
  currency      String        @default("USD")
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(PENDING)
  dateCreated   DateTime      @default(now())
  lastEdit      DateTime      @default(now()) @updatedAt

  user           User?              @relation(fields: [userID], references: [id], onDelete: SetNull)
  address        Address?           @relation(fields: [addressID], references: [id], onDelete: SetNull)
  items             OrderItem[]
  stockMovements    StockMovement[]
  accessTokens      OrderAccessToken[]
  couponRedemption  CouponRedemption?

  @@index([userID])
  @@index([status])
  @@index([dateCreated])
  @@index([flaggedForReview])
  @@map("order")
}

// Short-lived, single-use email OTP challenge for checkout — same
// hashed/short-lived/single-use shape as PasswordResetToken, extended to two
// phases: a 6-digit code sent by email (`codeHash`), then a "verified"
// ticket minted after a correct code (`verifyTokenHash`) that checkout
// actually redeems. Guest-compatible (no userID) since a guest has no
// account to key this on — see checkout-otp.service.ts.
model CheckoutOtp {
  id    String @id @default(uuid()) @db.Uuid
  email String // lower-cased

  // Phase 1 — the code actually emailed to the customer.
  codeHash      String
  codeExpiresAt DateTime
  attempts      Int      @default(0) // failed verify attempts against codeHash; capped in app code

  // Phase 2 — minted only after a correct code; this is what checkout redeems.
  verifiedAt           DateTime?
  verifyTokenHash      String?   @unique
  verifyTokenExpiresAt DateTime?
  consumedAt           DateTime? // set when an order actually redeems the ticket (single-use)

  requestIP String? // the IP that requested this code — drives per-IP rate limiting
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([requestIP, createdAt])
  @@map("checkoutotp")
}

enum BlacklistType {
  PHONE
  EMAIL
  IP
}

// Explicit, admin-maintained block list, checked at checkout-OTP request
// time (don't spend an email on a blocked address) and at order-creation
// time (hard-blocks the order outright) — see order.service.ts. Distinct
// from the automatic order-velocity soft-flag: a BlacklistEntry hit is a
// deliberate admin decision, not a heuristic.
model BlacklistEntry {
  id        String        @id @default(uuid()) @db.Uuid
  type      BlacklistType
  value     String // normalized phone, lower-cased email, or raw IP
  reason    String?
  createdBy String?       @db.Uuid
  createdAt DateTime      @default(now())

  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([type, value])
  @@index([type, value])
  @@map("blacklistentry")
}

// One row per browser/device an admin has opted into order-alert push
// notifications on — see notification.service.ts's sendPushToAllAdmins.
// `endpoint` (the push service URL) is naturally unique per subscription, so
// saving is an upsert keyed on it: the same browser re-subscribing overwrites
// its own row instead of creating a duplicate.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userID    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String // subscription.keys.p256dh
  auth      String // subscription.keys.auth
  userAgent String? // context only — not used for anything functional yet
  createdAt DateTime @default(now())

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID])
  @@map("pushsubscription")
}

// A guest's (or anyone's) proof of access to one order without a login
// session — the checkout confirmation email links to
// /orders/track/<raw token>; POST /api/orders/lookup mints an additional one
// on a successful order-number + contact match. A table rather than a single
// hashed column on Order: the hash is one-way, so if the guest loses the
// original email a fresh row is minted without touching (or invalidating)
// the one already sitting in that email. Every token — however it was
// issued — carries the same flat expiry (see order.schema.ts).
model OrderAccessToken {
  id        String   @id @default(uuid()) @db.Uuid
  orderID   String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderID], references: [id], onDelete: Cascade)

  @@index([orderID])
  @@map("orderaccesstoken")
}

model OrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  orderID         String  @db.Uuid
  variantID       String  @db.Uuid
  // Full snapshot so a historical order stays displayable even if the
  // product/variant is later edited or deleted.
  productName     String
  productSKU      String
  variantSKU      String
  productImageUrl String?
  size            String?
  color           String?
  quantity        Int
  unitPrice       Decimal @db.Decimal(12, 2)
  lineTotal       Decimal @db.Decimal(12, 2) // unitPrice * quantity at order time

  order   Order          @relation(fields: [orderID], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantID], references: [id])

  @@index([orderID])
  @@map("orderitem")
}

// ============ SITE SETTINGS ============

// Single owner-editable row (id is always 1) that drives the storefront
// chrome the admin couldn't otherwise change without a deploy: the brand
// name, the announcement strip, the home hero copy, and the footer's
// social / contact links.
model SiteSetting {
  id                  Int     @id @default(1)
  brandNameEn         String  @default("Ali's Store")
  brandNameAr         String  @default("متجر علي")
  announcementActive  Boolean @default(true)
  heroEyebrowEn       String  @default("Limited stock")
  heroEyebrowAr       String  @default("كمية محدودة")
  heroHeadlineEn      String  @default("Buy it before someone else does.")
  heroHeadlineAr      String  @default("خدها قبل ما حدا غيرك ياخدها.")
  heroLedeEn          String  @default("Women, men and kids — clothing you actually wear, paid for on delivery.")
  heroLedeAr          String  @default("نساء ورجال وأطفال — ملابس ترتديها فعلاً، وتدفع عند الاستلام.")
  heroCtaLabelEn      String  @default("Discover")
  heroCtaLabelAr      String  @default("اكتشف الآن")
  // Which collection the hero's Discover button points at. null ⇒ the
  // storefront falls back to the first nav collection.
  heroCtaCollectionID String? @db.Uuid
  homeMoreHeadingEn   String  @default("More to explore")
  homeMoreHeadingAr   String  @default("المزيد لاكتشافه")

  // Optional "Our story" page. Title + body both null / "" in every language ⇒
  // the page and its footer link are hidden. Body is plain text; blank lines
  // separate paragraphs. An optional image sits beside the text.
  storyTitleEn    String?
  storyTitleAr    String?
  storyBodyEn     String?
  storyBodyAr     String?
  storyImageUrl   String?
  storyImageFileId String?

  // Footer links — null / "" ⇒ the link is hidden.
  instagramUrl        String?
  facebookUrl         String?
  tiktokUrl           String?
  whatsappUrl         String?
  contactEmail        String?
  contactPhone        String?

  // Sender identity for outgoing customer/owner email (order confirmations,
  // shipped/cancelled notices, password reset, checkout OTP…) — admin-set here
  // instead of hard-coded, overriding SMTP_FROM from the environment when set.
  // null ⇒ falls back to SMTP_FROM. See lib/mailer.ts's resolveFrom().
  mailFromName  String?
  mailFromEmail String?

  // Delivery fee. `deliveryFeeEnabled` off ⇒ every order ships free.
  // `deliveryFeeFlat` applies to any governorate without a `DeliveryRate`
  // override. `freeDeliveryThreshold` (null ⇒ off) waives the fee once the
  // subtotal reaches it; `freeDeliveryRegions` waives it for those governorates.
  deliveryFeeEnabled    Boolean  @default(false)
  deliveryFeeFlat       Decimal  @default(0) @db.Decimal(12, 2)
  freeDeliveryThreshold Decimal? @db.Decimal(12, 2)
  freeDeliveryRegions   String[] @default([])

  lastEdit DateTime @updatedAt

  heroCtaCollection Collection?        @relation(fields: [heroCtaCollectionID], references: [id], onDelete: SetNull)
  announcementLines AnnouncementLine[]
  deliveryRates     DeliveryRate[]
  storeLocations    StoreLocation[]
  reviewImages      ReviewImage[]
  showcases         HomeShowcase[]

  @@map("sitesetting")
}

// Admin/staff-uploaded screenshots of customer reviews, shown as a
// horizontally-scrolling strip on the home page under "Visit us". Replace-all
// on save (like StoreLocation); an empty set hides the strip.
model ReviewImage {
  id          String  @id @default(uuid()) @db.Uuid
  settingID   Int
  imageUrl    String
  imageFileId String?
  sortOrder   Int     @default(0)

  setting SiteSetting @relation(fields: [settingID], references: [id], onDelete: Cascade)

  @@index([settingID])
  @@map("reviewimage")
}

// One row per built-in smart home-page row (see ShowcaseType). Off by default;
// when `isActive`, it renders as a horizontal product scroller slotted into the
// featured-row list by `sortOrder` — the same ranking key featured collections
// and categories use. `labelEn`/`labelAr` override the default heading.
// Replace-all on settings update, like DeliveryRate.
model HomeShowcase {
  type      ShowcaseType
  settingID Int          @default(1)
  isActive  Boolean      @default(false)
  sortOrder Int          @default(0)
  labelEn   String?
  labelAr   String?
  lastEdit  DateTime     @default(now()) @updatedAt

  setting SiteSetting @relation(fields: [settingID], references: [id], onDelete: Cascade)

  @@id([type])
  @@index([settingID])
  @@map("homeshowcase")
}

// A physical store the customer can visit — the home page's "Visit us"
// section renders one card per location (and is hidden entirely when there
// are none with an address or hours). Replace-all on settings update, like
// DeliveryRate, but each location owns its own StoreHours rows. All fields
// optional except order: a location may be just a name, just hours, etc.
// `mapUrl` is an http(s) link rendered as a "Get directions" anchor.
// `imageUrl` is an optional ImageKit backdrop for the card; `imageFileId` is
// that asset's id, kept so the file can be removed from ImageKit when the
// image is replaced or the location is deleted.
model StoreLocation {
  id          String  @id @default(uuid()) @db.Uuid
  settingID   Int
  nameEn      String?
  nameAr      String?
  addressEn   String?
  addressAr   String?
  mapUrl      String?
  imageUrl    String?
  imageFileId String?
  sortOrder   Int     @default(0)

  setting SiteSetting  @relation(fields: [settingID], references: [id], onDelete: Cascade)
  hours   StoreHours[]

  @@index([settingID])
  @@map("storelocation")
}

// One row per day a StoreLocation is open. A day with no row is shown as
// "Closed" on the storefront. `dayOfWeek` is 0 = Monday … 6 = Sunday and also
// the display order. Times are "HH:MM" 24-hour strings.
model StoreHours {
  id         String @id @default(uuid()) @db.Uuid
  locationID String @db.Uuid
  dayOfWeek  Int
  opensAt    String
  closesAt   String

  location StoreLocation @relation(fields: [locationID], references: [id], onDelete: Cascade)

  @@unique([locationID, dayOfWeek])
  @@index([locationID])
  @@map("storehours")
}

// Per-governorate delivery-fee override. Replace-all on update, like
// AnnouncementLine. A governorate with no row here pays SiteSetting.deliveryFeeFlat.
model DeliveryRate {
  id        String  @id @default(uuid()) @db.Uuid
  settingID Int
  region    String // one of the DELIVERY_REGIONS values (see src/lib/regions.ts)
  fee       Decimal @db.Decimal(12, 2)
  sortOrder Int     @default(0)

  setting SiteSetting @relation(fields: [settingID], references: [id], onDelete: Cascade)

  @@unique([settingID, region])
  @@index([settingID])
  @@map("deliveryrate")
}

// One rotating line of the announcement strip. Replace-all on update.
model AnnouncementLine {
  id        String @id @default(uuid()) @db.Uuid
  settingID Int
  textEn    String
  textAr    String
  sortOrder Int    @default(0)

  setting SiteSetting @relation(fields: [settingID], references: [id], onDelete: Cascade)

  @@index([settingID])
  @@map("announcementline")
}

// Singleton row (id fixed to 1, same pattern as SiteSetting) holding the
// Google Drive OAuth connection for modules/backup, when it was established
// via the admin panel's "Connect Google Drive" flow rather than the
// GOOGLE_DRIVE_REFRESH_TOKEN env var (see drive.client.ts's
// getEffectiveRefreshToken — a row here, once it exists, takes priority over
// the env var, including a disconnected row with refreshToken: null).
// Deliberately its own table, NOT a SiteSetting column: SiteSetting is
// returned whole by the public GET /api/settings, and a refresh token must
// never be serialized into a public response.
model DriveCredential {
  id             Int       @id @default(1)
  refreshToken   String?
  connectedEmail String?
  connectedAt    DateTime?
  // Drive folder id for THIS connected account's backups — found-or-created
  // (by name; see drive.client.ts's ensureAppFolder) at connect time, not a
  // fixed id shared across every account. A folder id from GOOGLE_DRIVE_
  // BACKUP_FOLDER_ID belongs to whichever account created it; a different
  // connected account has no access to it, so the tool must not assume one
  // shared folder works for "connect any Drive account".
  folderId       String?
  updatedAt      DateTime  @updatedAt

  @@map("drivecredential")
}
