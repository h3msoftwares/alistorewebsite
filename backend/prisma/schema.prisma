// Ali'sStore — e-commerce schema
// Convention carried over from the original pos-backend schema:
// - uuid primary keys, PascalCase models mapped to lowercase tables (@@map)
// - camelCase columns, Decimal for money, soft-delete via deletedAt where relevant
// - dateCreated / createdAt naming kept per-model to match what pos-backend used

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum OAuthProvider {
  GOOGLE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  CARD // reserved for future online payment; application rejects it until a gateway is integrated
}

enum PaymentStatus {
  PENDING
  COLLECTED
  REFUNDED
}

enum StockMovementType {
  INITIAL
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  RESTOCK
}

// How a product's sale is expressed: a percentage off (0–100) or a flat
// amount off the price. Reused for the product's own sale, Promotion, and
// Coupon — kept as PERCENT/AMOUNT (not renamed to the architecture doc's
// FIXED_AMOUNT) since it's shared infrastructure well beyond Promotion.
enum DiscountType {
  PERCENT
  AMOUNT
}

// Built-in "smart" home-page rows — computed product lists the owner can turn
// on and slot into the featured-row order without creating a real category.
enum ShowcaseType {
  BEST_SELLERS
  NEW_ARRIVALS
  ON_SALE
}

// ============ USERS / AUTH ============

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String?   @unique
  emailVerified       DateTime? // set automatically on first Google OAuth login (Google pre-verifies)
  phone               String?   @unique
  passwordHash        String? // null for OAuth-only accounts
  name                String
  role                UserRole  @default(CUSTOMER)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0) // reset to 0 on any successful login
  lockedUntil         DateTime? // set when failedLoginAttempts crosses the threshold; login refused until this passes
  dateCreated         DateTime  @default(now())
  deletedAt           DateTime?

  // RBAC. `role` is the coarse gate (CUSTOMER = storefront only; STAFF/ADMIN
  // may reach /admin). Granular admin access is by permission:
  //  - STAFF: the permission list of `customRole` (none ⇒ no admin access)
  //  - ADMIN: every permission, minus `revokedPermissions`
  // `revokedPermissions` also subtracts from a STAFF user's role grants.
  customRoleID       String?  @db.Uuid
  customRole         Role?    @relation(fields: [customRoleID], references: [id], onDelete: SetNull)
  revokedPermissions String[] @default([])

  addresses               Address[]
  cart                    Cart?
  favorites               Favorite[]
  orders                  Order[]
  refreshTokens           RefreshToken[]
  oauthAccounts           OAuthAccount[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  emailChangeRequests     EmailChangeRequest[]
  auditLogs               AuditLog[] // rows where this user was the actor
  stockMovements          StockMovement[] // manual stock adjustments made by this user
  blacklistEntries        BlacklistEntry[] // entries this admin created
  pushSubscriptions       PushSubscription[] // this admin's opted-in browser/device(s)
  loyaltyAwards           LoyaltyAward[] // loyalty-program milestones this customer has earned

  @@index([role])
  @@index([customRoleID])
  @@map("user")
}

// A named set of admin permissions the owner defines from /admin/roles and
// assigns to STAFF users. Permission keys are "<area>:view" / "<area>:manage"
// (see backend/src/lib/permissions.ts). `isSystem` roles can't be deleted.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  dateCreated DateTime @default(now())
  lastEdit    DateTime @default(now()) @updatedAt

  users User[]

  @@map("role")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userID            String    @db.Uuid
  familyID          String    @db.Uuid // shared across a rotation chain; revoke the whole family on replay
  tokenHash         String    @unique
  replacedByTokenID String?   @unique @db.Uuid // the token issued when this one was rotated
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  // When a password was last actually verified for this login (step-up auth).
  // Set at login; carried UNCHANGED through every silent rotation so a kept
  // -alive session never looks freshly authenticated. A fresh login or an
  // explicit /api/auth/step-up starts a new family with a new authTime.
  authTime          DateTime  @default(now())

  user       User          @relation(fields: [userID], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedByTokenID], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userID])
  @@index([familyID])
  @@map("refreshtoken")
}

// Single-use, short-expiry token for the forgotten-password flow. Same shape
// as RefreshToken: only the hash is stored.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userID    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID])
  @@map("passwordresettoken")
}

// Single-use, short-expiry token for the email-verification flow (customer
// registration + resend-verification). Identical shape to PasswordResetToken:
// only the SHA-256 hash of the raw token is stored, never the token itself.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userID    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID])
  @@map("emailverificationtoken")
}

// Account email change (Task 3): the new address only lands on User.email
// once this token is confirmed FROM a link sent TO that new address — proof
// of control, same shape as EmailVerificationToken but kept as its own table
// since a successful verify here does something different (replace
// User.email + stamp emailVerified, not just stamp emailVerified) and the
// two token spaces must never be interchangeable.
model EmailChangeRequest {
  id        String    @id @default(uuid()) @db.Uuid
  userID    String    @db.Uuid
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID])
  @@map("emailchangerequest")
}

// External identity (Google today; enum leaves room for more). One row per
// provider account linked to a User.
model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userID            String        @db.Uuid
  provider          OAuthProvider
  providerAccountID String // the "sub" claim from the provider
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime      @default(now())
  lastEdit          DateTime      @default(now()) @updatedAt

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountID])
  @@index([userID])
  @@map("oauthaccount")
}

// Generic append-only audit trail. One table for every logged event (admin
// login attempts, order status changes, stock edits, ...) instead of a table
// per event type. `metadata` is a loose JSON blob for event-specific detail.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String // e.g. "order", "user", "productVariant"
  entityID   String? // id of the affected row, when there is one
  action     String // e.g. "login.failed", "order.status_changed", "stock.adjusted"
  actorID    String?  @db.Uuid // the acting user, when known (null for anonymous/system)
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorID], references: [id], onDelete: SetNull)

  @@index([entityType, entityID])
  @@index([actorID])
  @@index([createdAt])
  @@map("auditlog")
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userID      String   @db.Uuid
  fullName    String
  phone       String
  addressLine String
  city        String
  area        String?
  region      String? // Lebanese governorate — one of the DELIVERY_REGIONS values
  notes       String?
  isDefault   Boolean  @default(false)
  dateCreated DateTime @default(now())

  user   User    @relation(fields: [userID], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userID])
  @@map("address")
}

// ============ CATALOG ============

// A flexible, flat merchandising grouping — cuts ACROSS the category tree
// (e.g. "Sale", "New Arrivals"), not a level above it. Deliberately has no
// relationship to Category at all: Category is the permanent navigation tree
// (Men -> Shoes -> Sport Shoes), Collection is an orthogonal cross-cutting
// group of products, membership is manual only (CollectionProduct) as of
// Stage 1 of the catalog redesign — see catalog-redesign-implementation-plan.md.
// Stage 2 adds CollectionRule for automated membership.
model Collection {
  id                String         @id @default(uuid()) @db.Uuid
  nameEn            String
  nameAr            String
  slug              String         @unique
  descriptionEn     String?
  descriptionAr     String?
  isActive          Boolean        @default(true)
  // Owner opts a collection into the top nav / footer; nav order is `sortOrder`.
  showInNav         Boolean        @default(false)
  // Owner opts a collection into the home page's featured row (own row: name +
  // horizontal scroll of its categories). Independent of showInNav — a
  // collection can be navigable without being featured, or vice versa.
  showOnHome        Boolean        @default(false)
  // Owner shows this collection on the home page as a full-width image banner
  // (coloured panel + CTA, and the photo). Takes precedence over showOnHome —
  // an image-collection is not also given a scrolling row.
  showOnHomeAsImage Boolean        @default(false)
  // Position in the top nav (with showInNav). NOT the home-page order.
  sortOrder         Int            @default(0)
  // Position on the home page — the single shared ranking key for EVERY home
  // block (featured collections, image banners, featured categories, smart
  // rows), so the owner orders them all in one list. Separate from sortOrder
  // so nav order and home order are independent.
  homeSortOrder     Int            @default(0)
  // #rrggbb — the storefront derives the --collection-accent* CSS custom
  // properties from this. null ⇒ the collection uses the default accent. Also
  // the background colour of the home-page image banner (showOnHomeAsImage).
  accentColor       String?
  // Call-to-action label on the home-page image banner (showOnHomeAsImage).
  // null / "" ⇒ a generic "Shop <name>". `descriptionEn`/`descriptionAr` fill
  // the banner's copy.
  homeImageCtaEn    String?
  homeImageCtaAr    String?
  // Set when the owner archives the collection from the admin: hidden from
  // the storefront, kept in the DB, restorable. Permanent delete is only
  // allowed once archived (and empty of products).
  archivedAt        DateTime?
  // Stage 2: MANUAL (default — Stage 1's only mode, e.g. Sale/New Arrivals as
  // seeded) keeps `products` (CollectionProduct) as the sole membership
  // source. AUTOMATED computes membership purely from `rules` at read time,
  // ignoring CollectionProduct entirely. HYBRID computes from `rules`, then
  // layers manual CollectionProduct.membership INCLUDE/EXCLUDE on top. See
  // collection-rules.ts.
  type              CollectionType @default(MANUAL)
  dateCreated       DateTime       @default(now())
  lastEdit          DateTime       @default(now()) @updatedAt

  images      CollectionImage[]
  products    CollectionProduct[]
  rules       CollectionRule[]
  siteHeroFor SiteSetting[]
  promotions  PromotionCollection[]

  @@index([isActive])
  @@index([archivedAt])
  @@map("collection")
}

enum CollectionType {
  MANUAL
  AUTOMATED
  HYBRID
}

// Manual collection membership. For a MANUAL collection this is the sole
// membership source (`membership` is always INCLUDE in practice). For a
// HYBRID collection, `rules` compute the base set and these rows overlay
// explicit INCLUDE/EXCLUDE on top — see collection-rules.ts. Meaningless for
// AUTOMATED collections (rules alone decide membership; any rows here are
// ignored).
model CollectionProduct {
  collectionID String               @db.Uuid
  productID    String               @db.Uuid
  membership   CollectionMembership @default(INCLUDE)
  sortOrder    Int                  @default(0)
  createdAt    DateTime             @default(now())

  collection Collection @relation(fields: [collectionID], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productID], references: [id], onDelete: Cascade)

  @@id([collectionID, productID])
  @@index([productID])
  @@map("collectionproduct")
}

enum CollectionMembership {
  INCLUDE
  EXCLUDE
}

// Structured, validated rule for an AUTOMATED/HYBRID collection — never raw
// SQL or admin-supplied code (matching this codebase's existing security bar
// for anything translated into a live query). Rules with the same
// `groupNumber` are ANDed together; different `groupNumber`s are ORed
// (standard rule-group semantics) — see collection-rules.ts for the
// safe field/operator/value -> Prisma-where translation.
model CollectionRule {
  id           String                 @id @default(uuid()) @db.Uuid
  collectionID String                 @db.Uuid
  groupNumber  Int                    @default(0)
  field        CollectionRuleField
  operator     CollectionRuleOperator
  value        Json?
  sortOrder    Int                    @default(0)

  collection Collection @relation(fields: [collectionID], references: [id], onDelete: Cascade)

  @@index([collectionID, groupNumber, sortOrder])
  @@map("collectionrule")
}

// Deliberately narrower than the architecture doc's template enum: BRAND and
// TAG are dropped because this Product model has no brand or tag concept at
// all — offering them as pickable rule fields with nothing behind them would
// be the same dead-control shape as the old Product.quantity field. Every
// value here corresponds to real, queryable data.
enum CollectionRuleField {
  PRODUCT_STATUS
  CATEGORY
  PRICE
  COMPARE_AT_PRICE
  HAS_ACTIVE_PROMOTION
  CREATED_AT
  STOCK_STATUS
}

enum CollectionRuleOperator {
  EQUALS
  NOT_EQUALS
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
  LESS_THAN_OR_EQUAL
  IN
  NOT_IN
  EXISTS
}

// Same shape/behaviour as ProductImage — a gallery table (url + bilingual alt
// + sortOrder), cascade-deleted with its parent. The "base" image is the row
// with the lowest sortOrder.
model CollectionImage {
  id           String  @id @default(uuid()) @db.Uuid
  collectionID String  @db.Uuid
  url          String
  // ImageKit's file id for this asset — lets us delete the underlying file
  // (not just the DB row) when the image is removed. Nullable: rows created
  // before this column existed have no known fileId, so they're left alone
  // on delete rather than guessed at.
  fileId       String?
  altEn        String?
  altAr        String?
  sortOrder    Int     @default(0)

  collection Collection @relation(fields: [collectionID], references: [id], onDelete: Cascade)

  @@index([collectionID])
  @@map("collectionimage")
}

// The permanent navigation tree (Men -> Shoes -> Sport Shoes -> ...),
// unlimited depth, self-referencing via `parentID`. Fully decoupled from
// Collection — see the note there. `path`/`depth` are denormalized read
// helpers maintained ONLY by the Postgres triggers in migration
// 20260912000000_category_tree (never by application code — see that
// migration's comment for why: a second, app-code-maintained source of truth
// for a derived value is exactly the failure shape `Product.quantity` already
// demonstrates in this codebase).
//
// Archived state is intentionally NEVER propagated onto children — it is
// computed at read time by walking the `parentID` chain (or, in bulk, via the
// `archivedCategoryClosure()` recursive query in category-tree.ts), so
// restoring an archived ancestor makes every descendant reachable again with
// zero writes to those descendant rows. See category-tree.ts.
model Category {
  id                String    @id @default(uuid()) @db.Uuid
  parentID          String?   @db.Uuid
  nameEn            String
  nameAr            String
  // Globally unique (not just per-sibling) — deliberate deviation from the
  // architecture doc's literal per-sibling-unique example, to keep the
  // existing flat /category/[slug] storefront route working unchanged.
  // Per-sibling-unique slugs would require path-based routing, which is a
  // frontend change out of Stage 1's scope.
  slug              String    @unique
  // Body copy for the full-bleed home banner (showOnHomeAsImage) — moved here
  // with the rest of the storefront-chrome fields below. Category otherwise
  // has no description surface (no category-page body copy today).
  descriptionEn     String?
  descriptionAr     String?
  isActive          Boolean   @default(true)
  // Owner opts a category into the home page's featured row (own row: name +
  // horizontal scroll of its products). Any depth.
  showOnHome        Boolean   @default(false)
  // Position among this category's siblings. NOT the home-page order.
  sortOrder         Int       @default(0)
  // Position of this category's OWN featured row on the home page — the same
  // shared key as Collection.homeSortOrder, so every home block orders in one
  // list. Separate from sortOrder (sibling order).
  homeSortOrder     Int       @default(0)
  // ---- Storefront chrome (moved here from Collection with Women/Men/Kids —
  // see catalog-redesign-implementation-plan.md's Stage 1 nav/banner
  // decision): the top nav and full-bleed home banners are keyed off
  // top-level Categories now, not Collection, since Collection no longer sits
  // above Category in the tree. Meaningful at any depth in principle, but the
  // storefront only expects these set on root categories in practice.
  showInNav         Boolean   @default(false)
  showOnHomeAsImage Boolean   @default(false)
  accentColor       String?
  homeImageCtaEn    String?
  homeImageCtaAr    String?
  // Admin's primary "remove" action — hidden from the storefront (itself and
  // every descendant, computed at read time), kept in the DB, restorable.
  // Permanent delete needs the category archived, and empty of both child
  // categories and products (primary or additional), first.
  archivedAt        DateTime?
  // Trigger-maintained. Slug-based (e.g. "/men/shoes/sport-shoes/") so
  // `WHERE path LIKE '/men/%'` finds every descendant of Men in one query.
  path              String    @default("")
  // Trigger-maintained. 0 for a root category.
  depth             Int       @default(0)

  parent          Category?           @relation("CategoryTree", fields: [parentID], references: [id], onDelete: Restrict)
  children        Category[]          @relation("CategoryTree")
  images          CategoryImage[]
  // A product's canonical category (breadcrumbs, canonical URL, reporting).
  primaryProducts Product[]           @relation("PrimaryCategory")
  // Additional (non-canonical) category placements — see ProductCategory.
  productLinks    ProductCategory[]
  promotions      PromotionCategory[]

  @@index([parentID, sortOrder])
  @@index([path])
  @@index([archivedAt])
  @@map("category")
}

// Same shape/behaviour as ProductImage. The "base" image is the row with the
// lowest sortOrder.
model CategoryImage {
  id         String  @id @default(uuid()) @db.Uuid
  categoryID String  @db.Uuid
  url        String
  // See CollectionImage.fileId.
  fileId     String?
  altEn      String?
  altAr      String?
  sortOrder  Int     @default(0)

  category Category @relation(fields: [categoryID], references: [id], onDelete: Cascade)

  @@index([categoryID])
  @@map("categoryimage")
}

model Product {
  id                String        @id @default(uuid()) @db.Uuid
  sku               String        @unique
  nameEn            String
  nameAr            String
  descriptionEn     String?
  descriptionAr     String?
  // The canonical category — required, non-null (every product has exactly
  // one canonical placement; deviates from the architecture doc's literal
  // nullable+SetNull example on purpose, matching this codebase's existing
  // convention of a required category and the existing "can't delete a
  // non-empty category" guard, which now also covers this FK — see
  // category.service.ts deleteCategory()). Zero or more ADDITIONAL
  // placements live in ProductCategory.
  primaryCategoryID String        @db.Uuid
  price             Decimal       @db.Decimal(12, 2)
  compareAtPrice    Decimal?      @db.Decimal(12, 2)
  // Active sale: PERCENT (0–100) or AMOUNT off `price`. Both null ⇒ no sale.
  saleType          DiscountType?
  saleValue         Decimal?      @db.Decimal(12, 2)
  // Product-level quantity. Free-standing signed integer — may be 0 or
  // negative (e.g. oversold), and has no bearing on `isActive`. Dead (never
  // derived from variant stock — see product-form.tsx/products admin list);
  // left untouched by the Stage 1 catalog redesign, which is scoped to
  // category/collection restructuring only.
  quantity          Int           @default(0)
  isActive          Boolean       @default(true)
  dateCreated       DateTime      @default(now())
  lastEdit          DateTime      @default(now()) @updatedAt
  deletedAt         DateTime?
  // Generated, READ-ONLY search haystack — Postgres computes it (see migration
  // 20260909180000_product_search_text): lower(nameEn + nameAr) plus a
  // punctuation/whitespace-stripped copy so "tshirt" matches "T-Shirt". It is
  // NOT NULL in the DB; typed optional here only so Prisma leaves it out of
  // every INSERT/UPDATE (a generated column rejects an explicit value). Never
  // write it from app code.
  searchText        String?

  primaryCategory Category            @relation("PrimaryCategory", fields: [primaryCategoryID], references: [id])
  categoryLinks   ProductCategory[]
  collectionLinks CollectionProduct[]
  images          ProductImage[]
  variants        ProductVariant[]
  favorites       Favorite[]
  promotions      PromotionProduct[]

  @@index([primaryCategoryID])
  @@map("product")
}

// A product's ADDITIONAL (non-canonical) category placements — e.g. a
// unisex shoe primarily under Men/.../Running, additionally linked into
// Women/.../Running. "Is product P in category C" is `primaryCategoryID ==
// C OR EXISTS a ProductCategory row` — see category-tree.ts's
// productCategoryFilter(), used everywhere that predicate is needed
// (category listing, discount matching) so it's expressed exactly once.
model ProductCategory {
  productID  String   @db.Uuid
  categoryID String   @db.Uuid
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productID], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryID], references: [id], onDelete: Restrict)

  @@id([productID, categoryID])
  @@index([categoryID])
  @@map("productcategory")
}

// A catalog-wide price reduction targeting any mix of products, categories
// (optionally including their descendants), and collections at once.
// Resolved live at read time (product listings, cart, checkout) — nothing is
// written onto Product. Stage 2 of the catalog redesign — replaces the old
// single-scope `Discount` model outright (dropped; zero seeded rows existed
// anywhere in this repo, so no backfill was needed — see
// catalog-redesign-implementation-plan.md).
//
// Resolution (see lib/pricing.ts pickPromotion — a decision this session
// made explicitly rather than inheriting the old implicit
// "most-specific-scope-wins" default): among every ACTIVE, in-window
// Promotion covering a product, the single HIGHEST `priority` wins outright
// — promotions never combine with each other, regardless of how many match.
// `stackable` answers a different, narrower question — carried forward
// unchanged in meaning from the old `Discount.stacking` (STACK/OVERRIDE),
// just as a boolean: true applies this promotion on top of the product's own
// sale, false replaces it (discounts the original price, ignoring the sale).
model Promotion {
  id           String          @id @default(uuid()) @db.Uuid
  nameEn       String
  nameAr       String
  status       PromotionStatus @default(DRAFT)
  type         DiscountType // PERCENT: 0–100; AMOUNT: currency off. Shared enum — see DiscountType's own comment.
  value        Decimal         @db.Decimal(12, 2)
  priority     Int             @default(0)
  stackable    Boolean         @default(true)
  // Site-wide — covers every product, with no product/category/collection
  // targets needed. A deliberate addition beyond the architecture doc's
  // literal Promotion sketch: the old Discount model this replaces supports
  // a `scope: ALL` site-wide discount (exercised by this codebase's own
  // tests), and neither the doc's schema nor a plain PromotionCategory over
  // every current root category preserves that — the latter would silently
  // stop covering a NEW root category added later. Mutually exclusive with
  // having any targets at all (enforced in promotion.service.ts).
  appliesToAll Boolean         @default(false)
  startsAt     DateTime?
  endsAt       DateTime?
  dateCreated  DateTime        @default(now())
  lastEdit     DateTime        @default(now()) @updatedAt

  products    PromotionProduct[]
  categories  PromotionCategory[]
  collections PromotionCollection[]

  @@index([status])
  @@index([startsAt, endsAt])
  @@map("promotion")
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

model PromotionProduct {
  promotionID String @db.Uuid
  productID   String @db.Uuid

  promotion Promotion @relation(fields: [promotionID], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productID], references: [id], onDelete: Cascade)

  @@id([promotionID, productID])
  @@index([productID])
  @@map("promotionproduct")
}

// `includeDescendants` reuses Category.path (Stage 1 infra) — no separate
// tree-walk needed, just a `path` prefix check at read time.
model PromotionCategory {
  promotionID        String  @db.Uuid
  categoryID         String  @db.Uuid
  includeDescendants Boolean @default(true)

  promotion Promotion @relation(fields: [promotionID], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryID], references: [id], onDelete: Restrict)

  @@id([promotionID, categoryID])
  @@index([categoryID])
  @@map("promotioncategory")
}

model PromotionCollection {
  promotionID  String @db.Uuid
  collectionID String @db.Uuid

  promotion  Promotion  @relation(fields: [promotionID], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionID], references: [id], onDelete: Cascade)

  @@id([promotionID, collectionID])
  @@index([collectionID])
  @@map("promotioncollection")
}

// A code the shopper enters at checkout for a discount off the (already
// per-product-sale + catalog-discount reduced) cart subtotal. Time-boxed by
// `startsAt` / `endsAt` (null ⇒ open-ended). No usage caps or per-customer
// limits — the code just works while active and in-window.
model Coupon {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @unique // stored upper-cased; compared case-insensitively
  type           DiscountType
  value          Decimal      @db.Decimal(12, 2) // PERCENT: 0–100; AMOUNT: currency off
  isActive       Boolean      @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  // Usage caps (enforced at checkout — see order.service.ts).
  //  `maxRedemptions` — total across all shoppers; null = unlimited.
  //  `maxPerCustomer` — per account / per guest-email; DEFAULTS TO 1 so a
  //    coupon is single-use per customer unless the admin opts into more (or
  //    null for unlimited). `timesRedeemed` is the atomic global counter.
  maxRedemptions Int?
  maxPerCustomer Int?         @default(1)
  timesRedeemed  Int          @default(0)
  dateCreated    DateTime     @default(now())
  lastEdit       DateTime     @default(now()) @updatedAt

  redemptions   CouponRedemption[]
  loyaltyAwards LoyaltyAward[] // set when this coupon was auto-generated as a loyalty reward

  @@map("coupon")
}

// One row per time a coupon is applied to an order. The audit trail behind
// the usage caps: `maxPerCustomer` is enforced by counting these.
model CouponRedemption {
  id        String   @id @default(uuid()) @db.Uuid
  couponID  String   @db.Uuid
  orderID   String   @unique @db.Uuid // one redemption per order
  userID    String?  @db.Uuid // null for a guest checkout
  email     String? // contact email — how a guest's per-customer count is keyed
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponID], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderID], references: [id], onDelete: Cascade)

  @@index([couponID, userID])
  @@index([couponID, email])
  @@map("couponredemption")
}

// Admin-configured "reward every N orders / $N spent" rule. Registered
// customers only — a persistent identity is what the milestone count is
// tracked against (see LoyaltyAward), so a guest checkout has nothing to
// accumulate onto. Checked in order.service.ts's updateOrderStatus, right
// where an order actually reaches DELIVERED (see LoyaltyAward doc comment
// for why DELIVERED-only and how the milestone math works).
model LoyaltyRule {
  id              String        @id @default(uuid()) @db.Uuid
  nameEn          String
  nameAr          String
  metric          LoyaltyMetric
  // The unit an admin reads/writes this in is metric-dependent (a plain
  // order count for ORDER_COUNT, a currency amount for TOTAL_SPENT) — both
  // fit one Decimal column, same as Coupon.value doing double duty for
  // PERCENT vs AMOUNT.
  threshold       Decimal       @db.Decimal(12, 2)
  isActive        Boolean       @default(true)
  rewardType      DiscountType
  rewardValue     Decimal       @db.Decimal(12, 2)
  // How long the auto-generated coupon stays redeemable after being issued;
  // null = no expiry. Independent of the rule's own isActive/lifetime.
  couponValidDays Int?
  dateCreated     DateTime      @default(now())
  lastEdit        DateTime      @default(now()) @updatedAt

  awards LoyaltyAward[]

  @@map("loyaltyrule")
}

enum LoyaltyMetric {
  ORDER_COUNT
  TOTAL_SPENT
}

// One row per milestone actually paid out to a customer under a rule — the
// audit trail AND the race-safety backstop (the unique index below), not
// just a log. `milestoneNumber` is how many multiples of the rule's
// threshold this award represents (1 = first time crossing it, 2 = second,
// ...), so "the next milestone due" is always
// max(milestoneNumber for this rule+user) + 1 — that's what makes a rule
// "repeat": reaching order #10 under a "every 5 orders" rule pays out
// milestone 2, not a second copy of milestone 1. A single order that jumps
// several milestones at once (e.g. one huge order crossing a $-spent
// threshold twice over) only ever awards the single newest milestone
// reached, not one coupon per skipped milestone — deliberate, to avoid
// coupon-spamming a customer over one order.
model LoyaltyAward {
  id              String   @id @default(uuid()) @db.Uuid
  ruleID          String   @db.Uuid
  userID          String   @db.Uuid
  milestoneNumber Int
  // Null if the coupon this award created has since been deleted from the
  // Coupons admin panel — the award itself still stands (the customer did
  // reach the milestone), only the reward's own row is gone.
  couponID        String?  @db.Uuid
  awardedAt       DateTime @default(now())

  rule   LoyaltyRule @relation(fields: [ruleID], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userID], references: [id], onDelete: Cascade)
  coupon Coupon?     @relation(fields: [couponID], references: [id], onDelete: SetNull)

  // One award per (rule, customer, milestone) — the DB-level guard against
  // double-awarding under concurrent DELIVERED transitions, same idiom as
  // the coupon-code collision retry: attempt the insert, treat a unique
  // violation as "someone else just did this" rather than locking upfront.
  @@unique([ruleID, userID, milestoneNumber])
  @@index([userID])
  @@map("loyaltyaward")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productID String  @db.Uuid
  url       String
  // See CollectionImage.fileId.
  fileId    String?
  altEn     String?
  altAr     String?
  sortOrder Int     @default(0)
  // Ties this image to one colour option (matches ProductVariant.color) — the
  // product page swaps to the matching image(s) when that colour is selected.
  // null = shown regardless of colour (generic/fallback shots).
  color     String?

  product Product @relation(fields: [productID], references: [id], onDelete: Cascade)

  @@index([productID])
  @@map("productimage")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productID     String   @db.Uuid
  sku           String   @unique
  size          String? // nullable: not every product has a size (one-size accessories, etc.)
  color         String? // nullable: not every product has a colour variation
  // Per-variant price override — null falls back to Product.price, so
  // different sizes/colours of the same product can share one price or each
  // carry their own.
  price         Decimal? @db.Decimal(12, 2)
  // DB CHECK ("stockQuantity" >= 0) — see migration
  // 20260908234500_stock_nonnegative_check. Prisma can't express CHECKs in
  // the schema; the authoritative oversell guard is the atomic conditional
  // decrement in order.service.ts, this is the backstop.
  stockQuantity Int      @default(0)

  product        Product         @relation(fields: [productID], references: [id], onDelete: Cascade)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  // NOTE: no more @@unique([productID, size, color]) — Postgres treats each NULL
  // as distinct, so it would no longer catch duplicate (null,null) variants.
  // Duplicate-variant prevention is now enforced in application code.
  @@index([productID])
  @@map("productvariant")
}

// Append-only stock ledger: every change to ProductVariant.stockQuantity gets
// a row here recording the signed delta and why. `stockQuantity` stays as the
// materialized current value.
model StockMovement {
  id        String            @id @default(uuid()) @db.Uuid
  variantID String            @db.Uuid
  quantity  Int // signed delta: negative for a sale, positive for a restock
  type      StockMovementType
  reason    String?
  orderID   String?           @db.Uuid // set when the movement was caused by an order
  actorID   String?           @db.Uuid // the staff/admin user for a manual adjustment
  createdAt DateTime          @default(now())

  variant ProductVariant @relation(fields: [variantID], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderID], references: [id], onDelete: SetNull)
  actor   User?          @relation(fields: [actorID], references: [id], onDelete: SetNull)

  @@index([variantID])
  @@index([orderID])
  @@map("stockmovement")
}

// ============ CART ============

// One Cart per user (userID unique) or per guest session (sessionID unique).
// Guest->user merge on login re-points / merges a single Cart row instead of
// rewriting every CartItem.
model Cart {
  id          String   @id @default(uuid()) @db.Uuid
  userID      String?  @unique @db.Uuid
  sessionID   String?  @unique
  currency    String   @default("USD")
  dateCreated DateTime @default(now())
  lastEdit    DateTime @default(now()) @updatedAt

  user  User?      @relation(fields: [userID], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("cart")
}

model CartItem {
  id          String   @id @default(uuid()) @db.Uuid
  cartID      String   @db.Uuid
  variantID   String   @db.Uuid
  quantity    Int      @default(1)
  dateCreated DateTime @default(now())

  cart    Cart           @relation(fields: [cartID], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantID], references: [id], onDelete: Cascade)

  @@unique([cartID, variantID])
  @@index([cartID])
  @@map("cartitem")
}

// ============ FAVORITES ============

// A shopper's wishlist. One row per (user, product) — hearting is idempotent,
// enforced by the composite unique. Guests keep their hearts client-side
// (favouritesSlice + localStorage); this table is the logged-in mirror, so
// every /api/favourites route sits behind requireAuth like /api/addresses.
model Favorite {
  id          String   @id @default(uuid()) @db.Uuid
  userID      String   @db.Uuid
  productID   String   @db.Uuid
  dateCreated DateTime @default(now())

  user    User    @relation(fields: [userID], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productID], references: [id], onDelete: Cascade)

  @@unique([userID, productID])
  @@index([userID])
  @@map("favorite")
}

// ============ ORDERS ============

model Order {
  id          String  @id @default(uuid()) @db.Uuid
  orderNumber String  @unique
  userID      String? @db.Uuid
  addressID   String? @db.Uuid // reference to a saved Address, when the customer used one
  guestEmail  String? // contact email for a guest order (no saved account)

  // Anti-abuse — see BlacklistEntry / CheckoutOtp. Captured from req.ip at
  // checkout time; used for both the hard blacklist check and the soft
  // order-velocity flag below.
  ipAddress        String?
  // Soft flag: an automatic order-velocity threshold was crossed (see
  // order.service.ts checkout()). The order is still created normally —
  // this only surfaces it for admin review, unlike a BlacklistEntry hit
  // which hard-blocks instead.
  flaggedForReview Boolean @default(false)
  // Short machine string, e.g. "velocity:phone,velocity:ip" — which
  // threshold(s) tripped, for admin context. Null when not flagged.
  flaggedReason    String?

  // Delivery snapshot — captured at order time so a later edit/delete of the
  // saved Address never changes what this order shows was delivered where.
  deliveryName    String
  deliveryPhone   String
  deliveryAddress String
  deliveryCity    String
  deliveryArea    String?
  deliveryRegion  String? // Lebanese governorate — set on every new checkout; null only on legacy rows
  deliveryNotes   String?

  notes                 String? // general order notes from the customer
  // Set by the admin when the order is shipped (or any later status change) —
  // the "arrives in about N days" estimate; also used in the shipped email.
  estimatedDeliveryDays Int?
  subtotal              Decimal       @db.Decimal(12, 2) // merchandise after per-product sales + catalog discounts, before any coupon
  couponCode            String? // the coupon applied at checkout, upper-cased; null if none
  discountAmount        Decimal       @default(0) @db.Decimal(12, 2) // amount the coupon took off the subtotal
  deliveryFee           Decimal       @default(0) @db.Decimal(12, 2)
  total                 Decimal       @db.Decimal(12, 2) // subtotal - discountAmount + deliveryFee
  currency              String        @default("USD")
  paymentMethod         PaymentMethod @default(COD)
  paymentStatus         PaymentStatus @default(PENDING)
  status                OrderStatus   @default(PENDING)
  dateCreated           DateTime      @default(now())
  lastEdit              DateTime      @default(now()) @updatedAt

  user             User?              @relation(fields: [userID], references: [id], onDelete: SetNull)
  address          Address?           @relation(fields: [addressID], references: [id], onDelete: SetNull)
  items            OrderItem[]
  stockMovements   StockMovement[]
  accessTokens     OrderAccessToken[]
  couponRedemption CouponRedemption?

  @@index([userID])
  @@index([status])
  @@index([dateCreated])
  @@index([flaggedForReview])
  @@map("order")
}

// Short-lived, single-use email OTP challenge for checkout — same
// hashed/short-lived/single-use shape as PasswordResetToken, extended to two
// phases: a 6-digit code sent by email (`codeHash`), then a "verified"
// ticket minted after a correct code (`verifyTokenHash`) that checkout
// actually redeems. Guest-compatible (no userID) since a guest has no
// account to key this on — see checkout-otp.service.ts.
model CheckoutOtp {
  id    String @id @default(uuid()) @db.Uuid
  email String // lower-cased

  // Phase 1 — the code actually emailed to the customer.
  codeHash      String
  codeExpiresAt DateTime
  attempts      Int      @default(0) // failed verify attempts against codeHash; capped in app code

  // Phase 2 — minted only after a correct code; this is what checkout redeems.
  verifiedAt           DateTime?
  verifyTokenHash      String?   @unique
  verifyTokenExpiresAt DateTime?
  consumedAt           DateTime? // set when an order actually redeems the ticket (single-use)

  requestIP String? // the IP that requested this code — drives per-IP rate limiting
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([requestIP, createdAt])
  @@map("checkoutotp")
}

enum BlacklistType {
  PHONE
  EMAIL
  IP
}

// Explicit, admin-maintained block list, checked at checkout-OTP request
// time (don't spend an email on a blocked address) and at order-creation
// time (hard-blocks the order outright) — see order.service.ts. Distinct
// from the automatic order-velocity soft-flag: a BlacklistEntry hit is a
// deliberate admin decision, not a heuristic.
model BlacklistEntry {
  id        String        @id @default(uuid()) @db.Uuid
  type      BlacklistType
  value     String // normalized phone, lower-cased email, or raw IP
  reason    String?
  createdBy String?       @db.Uuid
  createdAt DateTime      @default(now())

  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([type, value])
  @@index([type, value])
  @@map("blacklistentry")
}

// One row per browser/device an admin has opted into order-alert push
// notifications on — see notification.service.ts's sendPushToAllAdmins.
// `endpoint` (the push service URL) is naturally unique per subscription, so
// saving is an upsert keyed on it: the same browser re-subscribing overwrites
// its own row instead of creating a duplicate.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userID    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String // subscription.keys.p256dh
  auth      String // subscription.keys.auth
  userAgent String? // context only — not used for anything functional yet
  createdAt DateTime @default(now())

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID])
  @@map("pushsubscription")
}

// A guest's (or anyone's) proof of access to one order without a login
// session — the checkout confirmation email links to
// /orders/track/<raw token>; POST /api/orders/lookup mints an additional one
// on a successful order-number + contact match. A table rather than a single
// hashed column on Order: the hash is one-way, so if the guest loses the
// original email a fresh row is minted without touching (or invalidating)
// the one already sitting in that email. Every token — however it was
// issued — carries the same flat expiry (see order.schema.ts).
model OrderAccessToken {
  id        String   @id @default(uuid()) @db.Uuid
  orderID   String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderID], references: [id], onDelete: Cascade)

  @@index([orderID])
  @@map("orderaccesstoken")
}

model OrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  orderID         String  @db.Uuid
  variantID       String  @db.Uuid
  // Full snapshot so a historical order stays displayable even if the
  // product/variant is later edited or deleted.
  productName     String
  productSKU      String
  variantSKU      String
  productImageUrl String?
  size            String?
  color           String?
  quantity        Int
  unitPrice       Decimal @db.Decimal(12, 2)
  lineTotal       Decimal @db.Decimal(12, 2) // unitPrice * quantity at order time

  order   Order          @relation(fields: [orderID], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantID], references: [id])

  @@index([orderID])
  @@map("orderitem")
}

// ============ SITE SETTINGS ============

// Single owner-editable row (id is always 1) that drives the storefront
// chrome the admin couldn't otherwise change without a deploy: the brand
// name, the announcement strip, the home hero copy, and the footer's
// social / contact links.
model SiteSetting {
  id                  Int     @id @default(1)
  brandNameEn         String  @default("Ali'sStore")
  brandNameAr         String  @default("Ali'sStore")
  announcementActive  Boolean @default(true)
  heroEyebrowEn       String  @default("Limited stock")
  heroEyebrowAr       String  @default("كمية محدودة")
  heroHeadlineEn      String  @default("Buy it before someone else does.")
  heroHeadlineAr      String  @default("خدها قبل ما حدا غيرك ياخدها.")
  heroLedeEn          String  @default("Women, men and kids — clothing you actually wear, paid for on delivery.")
  heroLedeAr          String  @default("نساء ورجال وأطفال — ملابس ترتديها فعلاً، وتدفع عند الاستلام.")
  heroCtaLabelEn      String  @default("Discover")
  heroCtaLabelAr      String  @default("اكتشف الآن")
  // Which collection the hero's Discover button points at. null ⇒ the
  // storefront falls back to the first nav collection.
  heroCtaCollectionID String? @db.Uuid
  homeMoreHeadingEn   String  @default("More to explore")
  homeMoreHeadingAr   String  @default("المزيد لاكتشافه")

  // Optional "Our story" page. Title + body both null / "" in every language ⇒
  // the page and its footer link are hidden. Body is plain text; blank lines
  // separate paragraphs. An optional image sits beside the text.
  storyTitleEn     String?
  storyTitleAr     String?
  storyBodyEn      String?
  storyBodyAr      String?
  storyImageUrl    String?
  storyImageFileId String?

  // Footer links — null / "" ⇒ the link is hidden.
  instagramUrl String?
  facebookUrl  String?
  tiktokUrl    String?
  whatsappUrl  String?
  contactEmail String?
  contactPhone String?

  // Sender identity for outgoing customer/owner email (order confirmations,
  // shipped/cancelled notices, password reset, checkout OTP…) — admin-set here
  // instead of hard-coded, overriding SMTP_FROM from the environment when set.
  // null ⇒ falls back to SMTP_FROM. See lib/mailer.ts's resolveFrom().
  mailFromName  String?
  mailFromEmail String?

  // Delivery fee. `deliveryFeeEnabled` off ⇒ every order ships free.
  // `deliveryFeeFlat` applies to any governorate without a `DeliveryRate`
  // override. `freeDeliveryThreshold` (null ⇒ off) waives the fee once the
  // subtotal reaches it; `freeDeliveryRegions` waives it for those governorates.
  deliveryFeeEnabled    Boolean  @default(false)
  deliveryFeeFlat       Decimal  @default(0) @db.Decimal(12, 2)
  freeDeliveryThreshold Decimal? @db.Decimal(12, 2)
  freeDeliveryRegions   String[] @default([])

  lastEdit DateTime @updatedAt

  heroCtaCollection Collection?        @relation(fields: [heroCtaCollectionID], references: [id], onDelete: SetNull)
  announcementLines AnnouncementLine[]
  deliveryRates     DeliveryRate[]
  storeLocations    StoreLocation[]
  reviewImages      ReviewImage[]
  showcases         HomeShowcase[]

  @@map("sitesetting")
}

// Admin/staff-uploaded screenshots of customer reviews, shown as a
// horizontally-scrolling strip on the home page under "Visit us". Replace-all
// on save (like StoreLocation); an empty set hides the strip.
model ReviewImage {
  id          String  @id @default(uuid()) @db.Uuid
  settingID   Int
  imageUrl    String
  imageFileId String?
  sortOrder   Int     @default(0)

  setting SiteSetting @relation(fields: [settingID], references: [id], onDelete: Cascade)

  @@index([settingID])
  @@map("reviewimage")
}

// One row per built-in smart home-page row (see ShowcaseType). Off by default;
// when `isActive`, it renders as a horizontal product scroller slotted into the
// featured-row list by `sortOrder` — the same ranking key featured collections
// and categories use. `labelEn`/`labelAr` override the default heading.
// Replace-all on settings update, like DeliveryRate.
model HomeShowcase {
  type      ShowcaseType
  settingID Int          @default(1)
  isActive  Boolean      @default(false)
  sortOrder Int          @default(0)
  labelEn   String?
  labelAr   String?
  lastEdit  DateTime     @default(now()) @updatedAt

  setting SiteSetting @relation(fields: [settingID], references: [id], onDelete: Cascade)

  @@id([type])
  @@index([settingID])
  @@map("homeshowcase")
}

// A physical store the customer can visit — the home page's "Visit us"
// section renders one card per location (and is hidden entirely when there
// are none with an address or hours). Replace-all on settings update, like
// DeliveryRate, but each location owns its own StoreHours rows. All fields
// optional except order: a location may be just a name, just hours, etc.
// `mapUrl` is an http(s) link rendered as a "Get directions" anchor.
// `imageUrl` is an optional ImageKit backdrop for the card; `imageFileId` is
// that asset's id, kept so the file can be removed from ImageKit when the
// image is replaced or the location is deleted.
model StoreLocation {
  id          String  @id @default(uuid()) @db.Uuid
  settingID   Int
  nameEn      String?
  nameAr      String?
  addressEn   String?
  addressAr   String?
  mapUrl      String?
  imageUrl    String?
  imageFileId String?
  sortOrder   Int     @default(0)

  setting SiteSetting  @relation(fields: [settingID], references: [id], onDelete: Cascade)
  hours   StoreHours[]

  @@index([settingID])
  @@map("storelocation")
}

// One row per day a StoreLocation is open. A day with no row is shown as
// "Closed" on the storefront. `dayOfWeek` is 0 = Monday … 6 = Sunday and also
// the display order. Times are "HH:MM" 24-hour strings.
model StoreHours {
  id         String @id @default(uuid()) @db.Uuid
  locationID String @db.Uuid
  dayOfWeek  Int
  opensAt    String
  closesAt   String

  location StoreLocation @relation(fields: [locationID], references: [id], onDelete: Cascade)

  @@unique([locationID, dayOfWeek])
  @@index([locationID])
  @@map("storehours")
}

// Per-governorate delivery-fee override. Replace-all on update, like
// AnnouncementLine. A governorate with no row here pays SiteSetting.deliveryFeeFlat.
model DeliveryRate {
  id        String  @id @default(uuid()) @db.Uuid
  settingID Int
  region    String // one of the DELIVERY_REGIONS values (see src/lib/regions.ts)
  fee       Decimal @db.Decimal(12, 2)
  sortOrder Int     @default(0)

  setting SiteSetting @relation(fields: [settingID], references: [id], onDelete: Cascade)

  @@unique([settingID, region])
  @@index([settingID])
  @@map("deliveryrate")
}

// One rotating line of the announcement strip. Replace-all on update.
model AnnouncementLine {
  id        String @id @default(uuid()) @db.Uuid
  settingID Int
  textEn    String
  textAr    String
  sortOrder Int    @default(0)

  setting SiteSetting @relation(fields: [settingID], references: [id], onDelete: Cascade)

  @@index([settingID])
  @@map("announcementline")
}

// Singleton row (id fixed to 1, same pattern as SiteSetting) holding the
// Google Drive OAuth connection for modules/backup, when it was established
// via the admin panel's "Connect Google Drive" flow rather than the
// GOOGLE_DRIVE_REFRESH_TOKEN env var (see drive.client.ts's
// getEffectiveRefreshToken — a row here, once it exists, takes priority over
// the env var, including a disconnected row with refreshToken: null).
// Deliberately its own table, NOT a SiteSetting column: SiteSetting is
// returned whole by the public GET /api/settings, and a refresh token must
// never be serialized into a public response.
model DriveCredential {
  id             Int       @id @default(1)
  refreshToken   String?
  connectedEmail String?
  connectedAt    DateTime?
  // Drive folder id for THIS connected account's backups — found-or-created
  // (by name; see drive.client.ts's ensureAppFolder) at connect time, not a
  // fixed id shared across every account. A folder id from GOOGLE_DRIVE_
  // BACKUP_FOLDER_ID belongs to whichever account created it; a different
  // connected account has no access to it, so the tool must not assume one
  // shared folder works for "connect any Drive account".
  folderId       String?
  updatedAt      DateTime  @updatedAt

  @@map("drivecredential")
}

// The admin-configurable "send emails as" account (Task: admin panel →
// change the outgoing SMTP account, given an email + app password). Same
// DB-row-takes-priority-over-env pattern as DriveCredential above — once
// this row has a `user`, mailer.ts's getTransporter() uses it instead of the
// SMTP_* env vars; clearing it (user/encryptedPassword: null) reverts to the
// env fallback. Deliberately its own table, not a SiteSetting column, for
// the same reason as DriveCredential: SiteSetting is returned whole by the
// public GET /api/settings, and this is a standing, directly-usable
// credential that must never be serialized into a public response.
//
// The app password is NOT stored in plaintext — `encryptedPassword` is
// AES-256-GCM ciphertext (see lib/secret-encryption.ts), keyed from
// JWT_ACCESS_SECRET with a domain-separation label. Unlike a Drive refresh
// token (useless without also knowing the OAuth client secret, and
// revocable at Google), an SMTP app password works the instant it's read —
// so DB access control alone isn't enough here, it gets real encryption.
model SmtpCredential {
  id                Int       @id @default(1)
  // The Gmail address this app authenticates as (SMTP AUTH user) — also
  // used as the connectivity-status display value. host/port are not
  // admin-configurable: the "app password" concept this flow asks for is
  // specifically Gmail's, so smtp-credential.service.ts hardcodes
  // smtp.gmail.com:587 for this path.
  user              String?
  encryptedPassword String?
  updatedAt         DateTime  @updatedAt
  updatedByID       String?

  @@map("smtpcredential")
}

enum BackupFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

// Singleton row (id fixed to 1, same pattern as DriveCredential/SiteSetting)
// holding the admin-configurable automatic-backup cadence. Read by both the
// admin panel (GET/PATCH /api/admin/backup/settings) and the scheduled
// GitHub Actions run (backend/scripts/run-backup.ts), which fires daily but
// only actually backs up when this interval has elapsed since the newest
// Drive backup — see backend/src/modules/backup/schedule.ts.
model BackupSettings {
  id        Int             @id @default(1)
  frequency BackupFrequency @default(WEEKLY)
  updatedAt DateTime        @updatedAt

  @@map("backupsettings")
}
