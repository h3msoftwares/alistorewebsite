// Ali's Store — e-commerce schema
// Convention carried over from the original pos-backend schema:
// - uuid primary keys, PascalCase models mapped to lowercase tables (@@map)
// - camelCase columns, Decimal for money, soft-delete via deletedAt where relevant
// - dateCreated / createdAt naming kept per-model to match what pos-backend used

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ ENUMS ============

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum OAuthProvider {
  GOOGLE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  CARD // reserved for future online payment; application rejects it until a gateway is integrated
}

enum PaymentStatus {
  PENDING
  COLLECTED
  REFUNDED
}

enum StockMovementType {
  INITIAL
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  RESTOCK
}

// How a product's sale is expressed: a percentage off (0–100) or a flat
// amount off the price.
enum DiscountType {
  PERCENT
  AMOUNT
}

// ============ USERS / AUTH ============

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String?   @unique
  emailVerified       DateTime? // set automatically on first Google OAuth login (Google pre-verifies)
  phone               String?   @unique
  passwordHash        String? // null for OAuth-only accounts
  name                String
  role                UserRole  @default(CUSTOMER)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0) // reset to 0 on any successful login
  lockedUntil         DateTime? // set when failedLoginAttempts crosses the threshold; login refused until this passes
  dateCreated         DateTime  @default(now())
  deletedAt           DateTime?

  addresses               Address[]
  cart                    Cart?
  favorites               Favorite[]
  orders                  Order[]
  refreshTokens           RefreshToken[]
  oauthAccounts           OAuthAccount[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  auditLogs               AuditLog[] // rows where this user was the actor
  stockMovements          StockMovement[] // manual stock adjustments made by this user
  blacklistEntries        BlacklistEntry[] // entries this admin created
  pushSubscriptions       PushSubscription[] // this admin's opted-in browser/device(s)

  @@index([role])
  @@map("user")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userID            String    @db.Uuid
  familyID          String    @db.Uuid // shared across a rotation chain; revoke the whole family on replay
  tokenHash         String    @unique
  replacedByTokenID String?   @unique @db.Uuid // the token issued when this one was rotated
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  user       User          @relation(fields: [userID], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedByTokenID], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userID])
  @@index([familyID])
  @@map("refreshtoken")
}

// Single-use, short-expiry token for the forgotten-password flow. Same shape
// as RefreshToken: only the hash is stored.
model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userID    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID])
  @@map("passwordresettoken")
}

// Single-use, short-expiry token for the email-verification flow (customer
// registration + resend-verification). Identical shape to PasswordResetToken:
// only the SHA-256 hash of the raw token is stored, never the token itself.
model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userID    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID])
  @@map("emailverificationtoken")
}

// External identity (Google today; enum leaves room for more). One row per
// provider account linked to a User.
model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userID            String        @db.Uuid
  provider          OAuthProvider
  providerAccountID String // the "sub" claim from the provider
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime      @default(now())
  lastEdit          DateTime      @default(now()) @updatedAt

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountID])
  @@index([userID])
  @@map("oauthaccount")
}

// Generic append-only audit trail. One table for every logged event (admin
// login attempts, order status changes, stock edits, ...) instead of a table
// per event type. `metadata` is a loose JSON blob for event-specific detail.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  entityType String // e.g. "order", "user", "productVariant"
  entityID   String? // id of the affected row, when there is one
  action     String // e.g. "login.failed", "order.status_changed", "stock.adjusted"
  actorID    String?  @db.Uuid // the acting user, when known (null for anonymous/system)
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorID], references: [id], onDelete: SetNull)

  @@index([entityType, entityID])
  @@index([actorID])
  @@index([createdAt])
  @@map("auditlog")
}

model Address {
  id          String   @id @default(uuid()) @db.Uuid
  userID      String   @db.Uuid
  fullName    String
  phone       String
  addressLine String
  city        String
  area        String?
  region      String? // Lebanese governorate — one of the DELIVERY_REGIONS values
  notes       String?
  isDefault   Boolean  @default(false)
  dateCreated DateTime @default(now())

  user   User    @relation(fields: [userID], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userID])
  @@map("address")
}

// ============ CATALOG ============

// Collections replace the old fixed Department enum. The owner can create any
// number of collections (e.g. Women, Men, Kids, Summer Sale) from the admin UI
// and attach categories to them. Hierarchy: Collection -> Category -> Product.
model Collection {
  id                String    @id @default(uuid()) @db.Uuid
  nameEn            String
  nameAr            String
  slug              String    @unique
  descriptionEn     String?
  descriptionAr     String?
  isActive          Boolean   @default(true)
  // Owner opts a collection into the top nav / footer; nav order reuses sortOrder.
  showInNav         Boolean   @default(false)
  // Owner opts a collection into the home page's featured row (own row: name +
  // horizontal scroll of its categories). Independent of showInNav — a
  // collection can be navigable without being featured, or vice versa. Order
  // among featured rows (collections AND categories, interleaved) reuses
  // sortOrder as a shared ranking key.
  showOnHome        Boolean   @default(false)
  // Owner shows this collection on the home page as a single square image (its
  // base image) in a grid at the top, with no category row. Position within
  // that grid reuses sortOrder. Takes precedence over showOnHome — an
  // image-collection is not also given a scrolling row.
  showOnHomeAsImage Boolean   @default(false)
  sortOrder         Int       @default(0)
  // #rrggbb — the storefront derives the --collection-accent* CSS custom
  // properties from this. null ⇒ the collection uses the default accent.
  accentColor       String?
  // Set when the owner archives the collection from the admin: hidden from
  // the storefront, kept in the DB, restorable. Permanent delete is only
  // allowed once archived (and empty of products).
  archivedAt        DateTime?
  dateCreated       DateTime  @default(now())
  lastEdit          DateTime  @default(now()) @updatedAt

  images      CollectionImage[]
  categories  Category[]
  products    Product[]
  siteHeroFor SiteSetting[]

  @@index([isActive])
  @@index([archivedAt])
  @@map("collection")
}

// Same shape/behaviour as ProductImage — a gallery table (url + bilingual alt
// + sortOrder), cascade-deleted with its parent. The "base" image is the row
// with the lowest sortOrder.
model CollectionImage {
  id           String  @id @default(uuid()) @db.Uuid
  collectionID String  @db.Uuid
  url          String
  // ImageKit's file id for this asset — lets us delete the underlying file
  // (not just the DB row) when the image is removed. Nullable: rows created
  // before this column existed have no known fileId, so they're left alone
  // on delete rather than guessed at.
  fileId       String?
  altEn        String?
  altAr        String?
  sortOrder    Int     @default(0)

  collection Collection @relation(fields: [collectionID], references: [id], onDelete: Cascade)

  @@index([collectionID])
  @@map("collectionimage")
}

model Category {
  id               String    @id @default(uuid()) @db.Uuid
  // Nullable: a category may stand alone, unattached to any collection. Deleting
  // a collection detaches its categories (SET NULL) rather than removing them.
  collectionID     String?   @db.Uuid
  nameEn           String
  nameAr           String
  slug             String    @unique
  parentCategoryID String?   @db.Uuid
  isActive         Boolean   @default(true)
  // Owner opts a category into the home page's featured row (own row: name +
  // horizontal scroll of its products) — independent of its parent
  // collection's own showOnHome. Shares the sortOrder ranking key with
  // Collection.showOnHome for one interleaved featured-row order.
  showOnHome       Boolean   @default(false)
  sortOrder        Int       @default(0)
  // See Collection.archivedAt — archive is the admin's primary "remove"
  // action; permanent delete needs the category archived and empty first.
  archivedAt       DateTime?

  collection Collection?     @relation(fields: [collectionID], references: [id], onDelete: SetNull)
  parent     Category?       @relation("CategoryToSubcategory", fields: [parentCategoryID], references: [id], onDelete: SetNull)
  children   Category[]      @relation("CategoryToSubcategory")
  images     CategoryImage[]
  products   Product[]

  @@index([collectionID])
  @@index([parentCategoryID])
  @@index([archivedAt])
  @@map("category")
}

// Same shape/behaviour as ProductImage. The "base" image is the row with the
// lowest sortOrder.
model CategoryImage {
  id         String  @id @default(uuid()) @db.Uuid
  categoryID String  @db.Uuid
  url        String
  // See CollectionImage.fileId.
  fileId     String?
  altEn      String?
  altAr      String?
  sortOrder  Int     @default(0)

  category Category @relation(fields: [categoryID], references: [id], onDelete: Cascade)

  @@index([categoryID])
  @@map("categoryimage")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  sku            String        @unique
  nameEn         String
  nameAr         String
  descriptionEn  String?
  descriptionAr  String?
  categoryID     String        @db.Uuid
  collectionID   String?       @db.Uuid // denormalized mirror of Category.collectionID (null when the category stands alone); derived from the category in app code, never set directly
  price          Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?      @db.Decimal(12, 2)
  // Active sale: PERCENT (0–100) or AMOUNT off `price`. Both null ⇒ no sale.
  saleType       DiscountType?
  saleValue      Decimal?      @db.Decimal(12, 2)
  // Product-level quantity. Free-standing signed integer — may be 0 or
  // negative (e.g. oversold), and has no bearing on `isActive`.
  quantity       Int           @default(0)
  isActive       Boolean       @default(true)
  dateCreated    DateTime      @default(now())
  lastEdit       DateTime      @default(now()) @updatedAt
  deletedAt      DateTime?

  category   Category         @relation(fields: [categoryID], references: [id])
  collection Collection?      @relation(fields: [collectionID], references: [id], onDelete: SetNull)
  images     ProductImage[]
  variants   ProductVariant[]
  favorites  Favorite[]

  @@index([categoryID])
  @@index([collectionID])
  @@map("product")
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productID String  @db.Uuid
  url       String
  // See CollectionImage.fileId.
  fileId    String?
  altEn     String?
  altAr     String?
  sortOrder Int     @default(0)
  // Ties this image to one colour option (matches ProductVariant.color) — the
  // product page swaps to the matching image(s) when that colour is selected.
  // null = shown regardless of colour (generic/fallback shots).
  color     String?

  product Product @relation(fields: [productID], references: [id], onDelete: Cascade)

  @@index([productID])
  @@map("productimage")
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productID     String   @db.Uuid
  sku           String   @unique
  size          String? // nullable: not every product has a size (one-size accessories, etc.)
  color         String? // nullable: not every product has a colour variation
  // Per-variant price override — null falls back to Product.price, so
  // different sizes/colours of the same product can share one price or each
  // carry their own.
  price         Decimal? @db.Decimal(12, 2)
  stockQuantity Int      @default(0)

  product        Product         @relation(fields: [productID], references: [id], onDelete: Cascade)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  // NOTE: no more @@unique([productID, size, color]) — Postgres treats each NULL
  // as distinct, so it would no longer catch duplicate (null,null) variants.
  // Duplicate-variant prevention is now enforced in application code.
  @@index([productID])
  @@map("productvariant")
}

// Append-only stock ledger: every change to ProductVariant.stockQuantity gets
// a row here recording the signed delta and why. `stockQuantity` stays as the
// materialized current value.
model StockMovement {
  id        String            @id @default(uuid()) @db.Uuid
  variantID String            @db.Uuid
  quantity  Int // signed delta: negative for a sale, positive for a restock
  type      StockMovementType
  reason    String?
  orderID   String?           @db.Uuid // set when the movement was caused by an order
  actorID   String?           @db.Uuid // the staff/admin user for a manual adjustment
  createdAt DateTime          @default(now())

  variant ProductVariant @relation(fields: [variantID], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderID], references: [id], onDelete: SetNull)
  actor   User?          @relation(fields: [actorID], references: [id], onDelete: SetNull)

  @@index([variantID])
  @@index([orderID])
  @@map("stockmovement")
}

// ============ CART ============

// One Cart per user (userID unique) or per guest session (sessionID unique).
// Guest->user merge on login re-points / merges a single Cart row instead of
// rewriting every CartItem.
model Cart {
  id          String   @id @default(uuid()) @db.Uuid
  userID      String?  @unique @db.Uuid
  sessionID   String?  @unique
  currency    String   @default("USD")
  dateCreated DateTime @default(now())
  lastEdit    DateTime @default(now()) @updatedAt

  user  User?      @relation(fields: [userID], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("cart")
}

model CartItem {
  id          String   @id @default(uuid()) @db.Uuid
  cartID      String   @db.Uuid
  variantID   String   @db.Uuid
  quantity    Int      @default(1)
  dateCreated DateTime @default(now())

  cart    Cart           @relation(fields: [cartID], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantID], references: [id], onDelete: Cascade)

  @@unique([cartID, variantID])
  @@index([cartID])
  @@map("cartitem")
}

// ============ FAVORITES ============

// A shopper's wishlist. One row per (user, product) — hearting is idempotent,
// enforced by the composite unique. Guests keep their hearts client-side
// (favouritesSlice + localStorage); this table is the logged-in mirror, so
// every /api/favourites route sits behind requireAuth like /api/addresses.
model Favorite {
  id          String   @id @default(uuid()) @db.Uuid
  userID      String   @db.Uuid
  productID   String   @db.Uuid
  dateCreated DateTime @default(now())

  user    User    @relation(fields: [userID], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productID], references: [id], onDelete: Cascade)

  @@unique([userID, productID])
  @@index([userID])
  @@map("favorite")
}

// ============ ORDERS ============

model Order {
  id          String  @id @default(uuid()) @db.Uuid
  orderNumber String  @unique
  userID      String? @db.Uuid
  addressID   String? @db.Uuid // reference to a saved Address, when the customer used one
  guestEmail  String? // contact email for a guest order (no saved account)

  // Anti-abuse — see BlacklistEntry / CheckoutOtp. Captured from req.ip at
  // checkout time; used for both the hard blacklist check and the soft
  // order-velocity flag below.
  ipAddress        String?
  // Soft flag: an automatic order-velocity threshold was crossed (see
  // order.service.ts checkout()). The order is still created normally —
  // this only surfaces it for admin review, unlike a BlacklistEntry hit
  // which hard-blocks instead.
  flaggedForReview Boolean @default(false)
  // Short machine string, e.g. "velocity:phone,velocity:ip" — which
  // threshold(s) tripped, for admin context. Null when not flagged.
  flaggedReason    String?

  // Delivery snapshot — captured at order time so a later edit/delete of the
  // saved Address never changes what this order shows was delivered where.
  deliveryName    String
  deliveryPhone   String
  deliveryAddress String
  deliveryCity    String
  deliveryArea    String?
  deliveryRegion  String? // Lebanese governorate — set on every new checkout; null only on legacy rows
  deliveryNotes   String?

  notes         String? // general order notes from the customer
  subtotal      Decimal       @db.Decimal(12, 2) // merchandise only
  deliveryFee   Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2) // subtotal + deliveryFee
  currency      String        @default("USD")
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)
  status        OrderStatus   @default(PENDING)
  dateCreated   DateTime      @default(now())
  lastEdit      DateTime      @default(now()) @updatedAt

  user           User?           @relation(fields: [userID], references: [id], onDelete: SetNull)
  address        Address?        @relation(fields: [addressID], references: [id], onDelete: SetNull)
  items          OrderItem[]
  stockMovements StockMovement[]

  @@index([userID])
  @@index([status])
  @@index([dateCreated])
  @@index([flaggedForReview])
  @@map("order")
}

// Short-lived, single-use email OTP challenge for checkout — same
// hashed/short-lived/single-use shape as PasswordResetToken, extended to two
// phases: a 6-digit code sent by email (`codeHash`), then a "verified"
// ticket minted after a correct code (`verifyTokenHash`) that checkout
// actually redeems. Guest-compatible (no userID) since a guest has no
// account to key this on — see checkout-otp.service.ts.
model CheckoutOtp {
  id    String @id @default(uuid()) @db.Uuid
  email String // lower-cased

  // Phase 1 — the code actually emailed to the customer.
  codeHash      String
  codeExpiresAt DateTime
  attempts      Int      @default(0) // failed verify attempts against codeHash; capped in app code

  // Phase 2 — minted only after a correct code; this is what checkout redeems.
  verifiedAt           DateTime?
  verifyTokenHash      String?   @unique
  verifyTokenExpiresAt DateTime?
  consumedAt           DateTime? // set when an order actually redeems the ticket (single-use)

  requestIP String? // the IP that requested this code — drives per-IP rate limiting
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([requestIP, createdAt])
  @@map("checkoutotp")
}

enum BlacklistType {
  PHONE
  EMAIL
  IP
}

// Explicit, admin-maintained block list, checked at checkout-OTP request
// time (don't spend an email on a blocked address) and at order-creation
// time (hard-blocks the order outright) — see order.service.ts. Distinct
// from the automatic order-velocity soft-flag: a BlacklistEntry hit is a
// deliberate admin decision, not a heuristic.
model BlacklistEntry {
  id        String        @id @default(uuid()) @db.Uuid
  type      BlacklistType
  value     String // normalized phone, lower-cased email, or raw IP
  reason    String?
  createdBy String?       @db.Uuid
  createdAt DateTime      @default(now())

  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([type, value])
  @@index([type, value])
  @@map("blacklistentry")
}

// One row per browser/device an admin has opted into order-alert push
// notifications on — see notification.service.ts's sendPushToAllAdmins.
// `endpoint` (the push service URL) is naturally unique per subscription, so
// saving is an upsert keyed on it: the same browser re-subscribing overwrites
// its own row instead of creating a duplicate.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userID    String   @db.Uuid
  endpoint  String   @unique
  p256dh    String // subscription.keys.p256dh
  auth      String // subscription.keys.auth
  userAgent String? // context only — not used for anything functional yet
  createdAt DateTime @default(now())

  user User @relation(fields: [userID], references: [id], onDelete: Cascade)

  @@index([userID])
  @@map("pushsubscription")
}

model OrderItem {
  id              String  @id @default(uuid()) @db.Uuid
  orderID         String  @db.Uuid
  variantID       String  @db.Uuid
  // Full snapshot so a historical order stays displayable even if the
  // product/variant is later edited or deleted.
  productName     String
  productSKU      String
  variantSKU      String
  productImageUrl String?
  size            String?
  color           String?
  quantity        Int
  unitPrice       Decimal @db.Decimal(12, 2)
  lineTotal       Decimal @db.Decimal(12, 2) // unitPrice * quantity at order time

  order   Order          @relation(fields: [orderID], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantID], references: [id])

  @@index([orderID])
  @@map("orderitem")
}

// ============ SITE SETTINGS ============

// Single owner-editable row (id is always 1) that drives the storefront
// chrome the admin couldn't otherwise change without a deploy: the brand
// name, the announcement strip, the home hero copy, and the footer's
// social / contact links.
model SiteSetting {
  id                  Int     @id @default(1)
  brandNameEn         String  @default("Ali's Store")
  brandNameAr         String  @default("متجر علي")
  announcementActive  Boolean @default(true)
  heroEyebrowEn       String  @default("Limited stock")
  heroEyebrowAr       String  @default("كمية محدودة")
  heroHeadlineEn      String  @default("Buy it before someone else does.")
  heroHeadlineAr      String  @default("خدها قبل ما حدا غيرك ياخدها.")
  heroLedeEn          String  @default("Women, men and kids — clothing you actually wear, paid for on delivery.")
  heroLedeAr          String  @default("نساء ورجال وأطفال — ملابس ترتديها فعلاً، وتدفع عند الاستلام.")
  heroCtaLabelEn      String  @default("Discover")
  heroCtaLabelAr      String  @default("اكتشف الآن")
  // Which collection the hero's Discover button points at. null ⇒ the
  // storefront falls back to the first nav collection.
  heroCtaCollectionID String? @db.Uuid
  homeMoreHeadingEn   String  @default("More to explore")
  homeMoreHeadingAr   String  @default("المزيد لاكتشافه")
  // Footer links — null / "" ⇒ the link is hidden.
  instagramUrl        String?
  facebookUrl         String?
  tiktokUrl           String?
  whatsappUrl         String?
  contactEmail        String?
  contactPhone        String?

  // Delivery fee. `deliveryFeeEnabled` off ⇒ every order ships free.
  // `deliveryFeeFlat` applies to any governorate without a `DeliveryRate`
  // override. `freeDeliveryThreshold` (null ⇒ off) waives the fee once the
  // subtotal reaches it; `freeDeliveryRegions` waives it for those governorates.
  deliveryFeeEnabled    Boolean  @default(false)
  deliveryFeeFlat       Decimal  @default(0) @db.Decimal(12, 2)
  freeDeliveryThreshold Decimal? @db.Decimal(12, 2)
  freeDeliveryRegions   String[] @default([])

  lastEdit DateTime @updatedAt

  heroCtaCollection Collection?        @relation(fields: [heroCtaCollectionID], references: [id], onDelete: SetNull)
  announcementLines AnnouncementLine[]
  deliveryRates     DeliveryRate[]

  @@map("sitesetting")
}

// Per-governorate delivery-fee override. Replace-all on update, like
// AnnouncementLine. A governorate with no row here pays SiteSetting.deliveryFeeFlat.
model DeliveryRate {
  id        String  @id @default(uuid()) @db.Uuid
  settingID Int
  region    String // one of the DELIVERY_REGIONS values (see src/lib/regions.ts)
  fee       Decimal @db.Decimal(12, 2)
  sortOrder Int     @default(0)

  setting SiteSetting @relation(fields: [settingID], references: [id], onDelete: Cascade)

  @@unique([settingID, region])
  @@index([settingID])
  @@map("deliveryrate")
}

// One rotating line of the announcement strip. Replace-all on update.
model AnnouncementLine {
  id        String @id @default(uuid()) @db.Uuid
  settingID Int
  textEn    String
  textAr    String
  sortOrder Int    @default(0)

  setting SiteSetting @relation(fields: [settingID], references: [id], onDelete: Cascade)

  @@index([settingID])
  @@map("announcementline")
}
