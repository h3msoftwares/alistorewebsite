NODE_ENV=development
PORT=4000
# Bind address. Leave 0.0.0.0 on a PaaS (Railway/Fly). On a VPS behind Nginx,
# set HOST=127.0.0.1 so Express is unreachable from the internet directly.
HOST=0.0.0.0
# On Neon / a managed pooler, use the POOLED url here with a bounded pool and
# add a separate DIRECT url for migrations, e.g.:
#   DATABASE_URL="postgresql://.../db?sslmode=require&pgbouncer=true&connection_limit=8&pool_timeout=10&connect_timeout=5"
#   (and pass --schema with directUrl for `prisma migrate deploy`)
# connection_limit/pool_timeout explicit rather than left to Prisma's default
# (num_cpus*2+1, opaque and machine-dependent) — fix-list.md #11, resolves
# 1.8: checkout() holds one pooled connection for its whole (multi-step,
# advisory-lock-serialized) transaction, so a flash-sale-scale burst of
# concurrent checkouts (confirmed at 25-50) exhausted a too-small pool and
# Prisma's 10s pool-acquire timeout turned the overflow into raw 500s instead
# of a clean rejection — real, available stock went unsold. 50 covers the
# worst case actually load-tested; pool_timeout raised to match
# CHECKOUT_TX_OPTIONS' own 20s transaction timeout in order.service.ts, so a
# briefly-queued checkout gets a real chance to acquire a connection instead
# of failing just under the transaction's own patience. Tune alongside your
# actual Postgres max_connections if you raise this further.
DATABASE_URL=postgresql://alistore:alistore@localhost:5432/alistore?schema=public&connection_limit=50&pool_timeout=20

# App-wide baseline rate limit: requests per IP per minute. Default 300.
# Raise transiently to ride out a known traffic spike; lower to clamp abuse.
# RATE_LIMIT_MAX=300
# Signing keys for access + refresh JWTs. MUST be different from each other and
# at least 32 chars. Generate real ones — do not ship these placeholders:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In production the server refuses to boot if either still looks like a
# placeholder (see src/config/env.ts).
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
# Shorter access-token lifetime for STAFF/ADMIN sessions (silent refresh just
# runs more often — it's automatic and invisible).
JWT_ADMIN_ACCESS_TTL=5m
JWT_REFRESH_TTL_DAYS=30
# Step-up auth: how recently (minutes) a password must have been entered for a
# sensitive admin action (order status change, stock edit). A silent refresh
# does NOT reset this; only a real login or POST /api/auth/step-up does.
STEP_UP_FRESHNESS_MIN=10
CORS_ORIGIN=http://localhost:3000

# Seed-only: the initial admin account's password (min 8 chars). Read by
# prisma/seed.ts and Argon2-hashed at seed time — the plaintext is never
# written to the database or committed to git. Set a strong value before
# running `npm run seed`.
SEED_ADMIN_PASSWORD=change-me-before-seeding

# Email (forgot-password) — any SMTP relay; shown here for Gmail. SMTP_PASSWORD
# is a 16-char Gmail "App Password" (Google Account > Security > App
# Passwords), NOT the account's real password — requires 2-Step Verification.
# Left unset, the server still boots; lib/mailer.ts just skips sending (logs a
# warning) instead of failing the request. This is the FALLBACK account only —
# once an admin sets one from the admin panel's "Outgoing mail account" card
# (Backups page), that DB-stored, encrypted credential takes priority over
# these vars (see modules/settings/smtp-credential.service.ts).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-the-sending-gmail-address
SMTP_PASSWORD=replace-with-a-gmail-app-password
SMTP_FROM="Ali's Store <replace-with-the-sending-gmail-address>"

# Password reset / email verification / account email change
RESET_TOKEN_TTL_MIN=30
EMAIL_VERIFICATION_TTL_MIN=1440
EMAIL_CHANGE_TTL_MIN=60
FRONTEND_URL=http://localhost:3000

# Order notifications — where the store owner is alerted when a new order
# comes in. Left unset, notification.service.ts just skips it (logs and
# no-ops) instead of failing checkout.
OWNER_NOTIFICATION_EMAIL=

# hCaptcha — gates POST /api/checkout/otp/request. The value below is
# hCaptcha's own documented test secret (works with frontend site key
# 10000000-ffff-ffff-ffff-000000000001 and dummy passcode
# 10000000-aaaa-bbbb-cccc-000000000001) — fine for dev/CI, but the server
# refuses to boot with it in production. Get a real sitekey/secret pair at
# https://dashboard.hcaptcha.com/ and set both this and the frontend's
# NEXT_PUBLIC_HCAPTCHA_SITE_KEY.
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# Web Push (admin order-alert notifications) — generate once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Left unset, the server still boots; notification.service.ts just skips the
# push channel (logs and no-ops) — email notifications are unaffected.
# Never rotate these casually: doing so invalidates every admin's existing
# subscription, and they'd all need to re-enable notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ImageKit (see frontend/.env.example for the matching NEXT_PUBLIC_IMAGEKIT_*
# vars) — the admin UI's image uploader asks this server for a short-lived
# signed token (GET /api/uploads/imagekit-auth, admin-only), then uploads the
# file straight from the browser to ImageKit with it. Get the private key
# from the ImageKit dashboard: Developer options > API Keys. Server-only —
# never expose it to the frontend. Left unset, the auth endpoint 503s with a
# clear "not configured" error instead of failing to boot.
IMAGEKIT_PRIVATE_KEY=replace-with-your-imagekit-private-key

# Google Analytics 4 Data API — powers the traffic / visitor / funnel widgets
# of the admin analytics dashboards (docs/ga4-setup.md walks through it):
#   1. Create a GA4 property, copy its numeric ID (Admin > Property Settings).
#   2. Create a Google Cloud service account, download its JSON key.
#   3. In GA4 Admin > Property Access Management, add the service-account email
#      with the "Viewer" role.
# Paste the JSON key's client_email and private_key below (keep the literal
# "\n" sequences in the key — ga.service.ts unescapes them). Left unset, the
# GA4-backed endpoints return { configured: false } and the dashboards show a
# connect-GA4 empty state; the first-party (orders/inventory) widgets still work.
GA4_PROPERTY_ID=
GA4_SA_CLIENT_EMAIL=
GA4_SA_PRIVATE_KEY=

# Google Drive database backups (see security/operations.md "Backups").
# A "Desktop app" OAuth client (Google Cloud Console > APIs & Services >
# Credentials), scope drive.file only. IMPORTANT: the consent screen must be
# published "In production" — left in "Testing", Google silently expires the
# refresh token after 7 days and scheduled backups start failing with no
# warning until someone checks.
#   1. Set GOOGLE_DRIVE_CLIENT_ID / GOOGLE_DRIVE_CLIENT_SECRET below.
#   2. Add TWO Authorized redirect URIs to that OAuth client in Google Cloud
#      Console: `http://localhost` (the one-time CLI script below) and
#      `${BACKEND_URL}/api/admin/backup/drive/callback` (the admin panel's
#      "Connect Google Drive" button — see BACKEND_URL further down).
#   3. Get a refresh token either way:
#      - Admin panel: sign in as ADMIN, open the Backups page, click
#        "Connect Google Drive" — this is the one most people want.
#      - Or the one-time CLI script (needed for the GitHub Actions secret,
#        since that job can't click a browser button): `npm run backup:token`
#        (backend/scripts) — writes GOOGLE_DRIVE_REFRESH_TOKEN into .env
#        itself. A connection made via the admin panel is stored in the
#        database and takes priority over this env var either way.
#   4. Create the destination folder in Drive, paste its id below.
# Left unset (both this var and no admin-panel connection on file),
# POST/GET /api/admin/backup respond with a clear "not configured" error
# instead of the server failing to boot.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
# How many of this tool's own dumps to keep on Drive; older ones are deleted
# after each successful upload.
BACKUP_RETENTION_COUNT=7
# pg_dump/pg_restore binaries — default to a PATH lookup (true once
# postgresql-client is installed in the backend's Docker image / CI runner).
# Override only if they're not on PATH (e.g. a Windows dev box whose Postgres
# runs in Docker with no client tools installed on the host).
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
# This API's own publicly-reachable base URL — only used to build the Google
# Drive OAuth callback redirect_uri above. In production, set this to the
# backend's real public URL (e.g. https://api.yourdomain.com) and register
# the matching callback URL in Google Cloud Console.
BACKEND_URL=http://localhost:4000
