NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://alistore:alistore@localhost:5432/alistore?schema=public
# Signing keys for access + refresh JWTs. MUST be different from each other and
# at least 32 chars. Generate real ones — do not ship these placeholders:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In production the server refuses to boot if either still looks like a
# placeholder (see src/config/env.ts).
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
# Shorter access-token lifetime for STAFF/ADMIN sessions (silent refresh just
# runs more often — it's automatic and invisible).
JWT_ADMIN_ACCESS_TTL=5m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGIN=http://localhost:3000

# Seed-only: the initial admin account's password (min 8 chars). Read by
# prisma/seed.ts and Argon2-hashed at seed time — the plaintext is never
# written to the database or committed to git. Set a strong value before
# running `npm run seed`.
SEED_ADMIN_PASSWORD=change-me-before-seeding
