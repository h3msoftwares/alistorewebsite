NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://alistore:alistore@localhost:5432/alistore?schema=public
# Signing keys for access + refresh JWTs. MUST be different from each other and
# at least 32 chars. Generate real ones — do not ship these placeholders:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In production the server refuses to boot if either still looks like a
# placeholder (see src/config/env.ts).
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-a-different-openssl-rand-hex-32
JWT_ACCESS_TTL=15m
# Shorter access-token lifetime for STAFF/ADMIN sessions (silent refresh just
# runs more often — it's automatic and invisible).
JWT_ADMIN_ACCESS_TTL=5m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGIN=http://localhost:3000

# Seed-only: the initial admin account's password (min 8 chars). Read by
# prisma/seed.ts and Argon2-hashed at seed time — the plaintext is never
# written to the database or committed to git. Set a strong value before
# running `npm run seed`.
SEED_ADMIN_PASSWORD=change-me-before-seeding

# Email (forgot-password) — any SMTP relay; shown here for Gmail. SMTP_PASSWORD
# is a 16-char Gmail "App Password" (Google Account > Security > App
# Passwords), NOT the account's real password — requires 2-Step Verification.
# Left unset, the server still boots; lib/mailer.ts just skips sending (logs a
# warning) instead of failing the request.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-the-sending-gmail-address
SMTP_PASSWORD=replace-with-a-gmail-app-password
SMTP_FROM="Ali's Store <replace-with-the-sending-gmail-address>"

# Password reset / email verification
RESET_TOKEN_TTL_MIN=30
EMAIL_VERIFICATION_TTL_MIN=1440
FRONTEND_URL=http://localhost:3000

# ImageKit (see frontend/.env.example for the matching NEXT_PUBLIC_IMAGEKIT_*
# vars) — the admin UI's image uploader asks this server for a short-lived
# signed token (GET /api/uploads/imagekit-auth, admin-only), then uploads the
# file straight from the browser to ImageKit with it. Get the private key
# from the ImageKit dashboard: Developer options > API Keys. Server-only —
# never expose it to the frontend. Left unset, the auth endpoint 503s with a
# clear "not configured" error instead of failing to boot.
IMAGEKIT_PRIVATE_KEY=replace-with-your-imagekit-private-key

# Google Analytics 4 Data API — powers the traffic / visitor / funnel widgets
# of the admin analytics dashboards (docs/ga4-setup.md walks through it):
#   1. Create a GA4 property, copy its numeric ID (Admin > Property Settings).
#   2. Create a Google Cloud service account, download its JSON key.
#   3. In GA4 Admin > Property Access Management, add the service-account email
#      with the "Viewer" role.
# Paste the JSON key's client_email and private_key below (keep the literal
# "\n" sequences in the key — ga.service.ts unescapes them). Left unset, the
# GA4-backed endpoints return { configured: false } and the dashboards show a
# connect-GA4 empty state; the first-party (orders/inventory) widgets still work.
GA4_PROPERTY_ID=
GA4_SA_CLIENT_EMAIL=
GA4_SA_PRIVATE_KEY=
