# "Tuned" emulation env — identical to backend.env EXCEPT the DATABASE_URL
# carries the Phase-D connection-pool settings, for the before/after run.
#
#   node loadtest/start-api.mjs --env loadtest/emulation/backend.tuned.env --db "<tuned url>"
# (start-api.mjs overrides DATABASE_URL from --db, so pass the tuned URL there.)

NODE_ENV=test
PORT=4000

# connection_limit sized for 1 vCPU (Prisma default would be cpus*2+1 = far too
# many on a shared box / against Neon's ceiling). pool_timeout: fail fast with a
# clear error instead of hanging when every connection is busy. connect_timeout:
# don't wait forever for a dead DB. sslmode omitted for the local cluster; on
# Neon use `sslmode=require` and add a separate directUrl for migrations.
DATABASE_URL=postgresql://alistore:alistore@127.0.0.1:5544/alistore?schema=public&connection_limit=8&pool_timeout=10&connect_timeout=5

JWT_ACCESS_SECRET=loadtest-emulation-access-secret-not-real-0000
JWT_REFRESH_SECRET=loadtest-emulation-refresh-secret-not-real-000
JWT_ACCESS_TTL=15m
JWT_ADMIN_ACCESS_TTL=5m
JWT_REFRESH_TTL_DAYS=30
STEP_UP_FRESHNESS_MIN=10
CORS_ORIGIN=http://localhost:4010,http://127.0.0.1:4010
FRONTEND_URL=http://localhost:3000
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000001
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
OWNER_NOTIFICATION_EMAIL=
IMAGEKIT_PRIVATE_KEY=
GA4_PROPERTY_ID=
GA4_SA_CLIENT_EMAIL=
GA4_SA_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SEED_ADMIN_PASSWORD=loadtest-admin-pw
RATE_LIMIT_MAX=1000000
