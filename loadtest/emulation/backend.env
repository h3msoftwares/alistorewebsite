# Emulation-stack backend env — LOCAL LOAD TESTING ONLY.
# Throwaway secrets generated for this stack; not used anywhere else.
# Overrides whatever backend/.env got baked into the image (compose env wins
# over process.loadEnvFile(), which does not overwrite already-set vars).

# NODE_ENV=test for load GENERATION only: it disables the per-IP rate limiters
# (a single-source load test otherwise shares one 10-login / 300-req bucket) and
# CSRF. Everything that governs latency/throughput — Express routing, Prisma,
# argon2, JSON (de)serialization, the query planner — is byte-for-byte identical
# to production. Production limiter behaviour is tested separately (report §20).
# A NODE_ENV=production parity spot-check is run for the browse path.
NODE_ENV=test
PORT=4000

# BASELINE: stock connection string, no pool tuning — this is what production
# runs today. The "tuned" run swaps in backend.tuned.env.
DATABASE_URL=postgresql://alistore:alistore@pg:5432/alistore?schema=public

# Placeholder secrets — fine because the emulation runs NODE_ENV=test, which
# skips assertStrongSecrets(). Never reuse these anywhere real.
JWT_ACCESS_SECRET=loadtest-emulation-access-secret-not-real-0000
JWT_REFRESH_SECRET=loadtest-emulation-refresh-secret-not-real-000
JWT_ACCESS_TTL=15m
JWT_ADMIN_ACCESS_TTL=5m
JWT_REFRESH_TTL_DAYS=30
STEP_UP_FRESHNESS_MIN=10

# Harness talks to the API directly; allow the loopback origins it may send.
CORS_ORIGIN=http://localhost:4010,http://127.0.0.1:4010
FRONTEND_URL=http://localhost:3000

# Non-test value so assertRealCaptchaSecret() passes. Real hCaptcha verify will
# fail with this, which is fine: the checkout load scenario uses verified
# logged-in customers that skip the OTP/captcha path entirely.
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000001

# Force the mailer / integrations into their no-op paths — no real sockets.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ali's Store <no-reply@loadtest.local>
OWNER_NOTIFICATION_EMAIL=
IMAGEKIT_PRIVATE_KEY=
GA4_PROPERTY_ID=
GA4_SA_CLIENT_EMAIL=
GA4_SA_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Seed-only.
SEED_ADMIN_PASSWORD=loadtest-admin-pw

# --- Phase D fix #0: make the global baseline limiter tunable ---
# Stock code hard-codes max:300/min and only reads NODE_ENV. A single-source
# load test all comes from one IP, so without this every run above ~5 rps is
# just 429s. Default stays 300 when unset; the app change is additive.
RATE_LIMIT_MAX=1000000
